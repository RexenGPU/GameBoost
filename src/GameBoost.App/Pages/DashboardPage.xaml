<UserControl x:Class="GameBoost.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls"
             xmlns:loc="clr-namespace:GameBoost.App.Localization"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnPageSizeChanged">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GameBoost" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Dash_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:Text Dash_Analyze}" Style="{StaticResource AccentButton}" Click="OnAnalyzeClick"
                        Padding="22,13" Margin="0,0,12,0"
                        ToolTip="{loc:Text Dash_AnalyzeTip}" />
                <Button x:Name="BoosterButton" Content="{loc:Text Dash_BoostGame}" Style="{StaticResource AccentButton}"
                        Click="OnBoosterClick" Padding="22,13"
                        ToolTip="{loc:Text Dash_BoostGameTip}" />
            </StackPanel>
        </Grid>

        <Border x:Name="PendingBanner" Grid.Row="1" Style="{StaticResource CardFlat}"
                Margin="0,16,0,0" Visibility="Collapsed"
                Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text Dash_PendingTitle}"
                               Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Text Dash_PendingBody}"
                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="{loc:Text Dash_RestoreNow}" Style="{StaticResource SecondaryButton}"
                        Click="OnRestorePendingClick" VerticalAlignment="Center" Margin="16,0,0,0"
                        ToolTip="{loc:Text Dash_RestoreNowTip}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text Dash_Realtime}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnRefreshDisksClick"
                        ToolTip="{loc:Text Dash_RefreshDisksTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{loc:Text Dash_Refresh}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="0,14,0,0">
                <controls:StatCard x:Name="CpuUsageCard" Title="{loc:Text Dash_CpuUsage}" Icon="&#xE9F0;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_CpuUsageTip}" />
                <controls:StatCard x:Name="GpuUsageCard" Title="{loc:Text Dash_GpuUsage}" Icon="&#xE7F4;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_GpuUsageTip}" />
                <controls:StatCard x:Name="CpuTempCard" Title="{loc:Text Dash_CpuTemp}" Icon="&#xE706;" Unit="°C"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_CpuTempTip}" />
                <controls:StatCard x:Name="GpuTempCard" Title="{loc:Text Dash_GpuTemp}" Icon="&#xE7C3;" Unit="°C"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_GpuTempTip}" />
                <controls:StatCard x:Name="RamCard" Title="{loc:Text Dash_RamUsed}" Icon="&#xE7C5;"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_RamUsedTip}" />
                <controls:StatCard x:Name="VramCard" Title="{loc:Text Dash_VramUsed}" Icon="&#xE77B;"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_VramUsedTip}" />
                <controls:StatCard x:Name="DiskCard" Title="{loc:Text Dash_DiskFree}" Icon="&#xE8B7;"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_DiskFreeTip}" />
                <controls:StatCard x:Name="NetFpsCard" Title="{loc:Text Dash_NetFps}" Icon="&#xE9D9;"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Dash_NetFpsTip}" />
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text Dash_Hardware}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Text Dash_HardwareDetails}" Style="{StaticResource GhostButton}"
                            Click="OnHardwareDetailsClick"
                            ToolTip="{loc:Text Dash_HardwareDetailsTip}" />
                </Grid>

                <StackPanel x:Name="HardwareLoadingPanel" Grid.Row="1" Margin="0,16,0,0">
                    <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
                    <TextBlock Text="{loc:Text Dash_HardwareLoading}" Style="{StaticResource BodyMuted}" Margin="0,9,0,0" />
                </StackPanel>

                <StackPanel x:Name="HardwarePanel" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,12" MinWidth="190">
                            <TextBlock Text="{loc:Text Dash_HwCpu}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="HwCpuText" Text="—" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,12" MinWidth="190">
                            <TextBlock Text="{loc:Text Dash_HwGpu}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="HwGpuText" Text="—" Style="{StaticResource Body}" Margin="0,4,0,0" />
                            <TextBlock x:Name="HwGpuSubText" Text="" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,12" MinWidth="190">
                            <TextBlock Text="{loc:Text Dash_HwRam}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="HwRamText" Text="—" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,12" MinWidth="190">
                            <TextBlock Text="{loc:Text Dash_HwOs}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="HwOsText" Text="—" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,12" MinWidth="190">
                            <TextBlock Text="{loc:Text Dash_HwDisplay}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="HwDisplayText" Text="—" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Dash_TopProcesses}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Text Dash_ManageAll}" Style="{StaticResource GhostButton}"
                                Click="OnProcessesClick"
                                ToolTip="{loc:Text Dash_ManageAllTip}" />
                    </Grid>
                    <StackPanel x:Name="ProcessList" Margin="0,14,0,0" />
                    <TextBlock x:Name="ProcessEmpty" Text="{loc:Text Dash_ProcessEmpty}"
                               Style="{StaticResource BodyMuted}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Text Dash_MyGames}" Style="{StaticResource H3}" />
                    <StackPanel x:Name="GamesList" Margin="0,14,0,0" />
                    <StackPanel x:Name="GamesEmptyPanel" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text Dash_GamesEmpty}"
                                   Style="{StaticResource BodyMuted}" />
                        <Button x:Name="ScanGamesButton" Content="{loc:Text Dash_ScanGames}" Style="{StaticResource AccentButton}"
                                Click="OnScanGamesClick" Margin="0,12,0,0" HorizontalAlignment="Left"
                                ToolTip="{loc:Text Dash_ScanGamesTip}" />
                        <ProgressBar x:Name="ScanProgress" Style="{StaticResource SlimProgress}" IsIndeterminate="True"
                                     Margin="0,12,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
