<Window x:Class="GameBoost.App.Pages.Dashboard.BoostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBoost — Assistant de boost"
        Width="800" Height="780" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                      GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgTitleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid Margin="20,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Assistant de boost" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Aucune modification sans résumé préalable" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="OnCloseClick"
                        FontFamily="{StaticResource IconFont}" FontSize="11" ToolTip="Fermer l'assistant">
                    <TextBlock Text="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="StepAPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="1. Configuration" Style="{StaticResource H2}" />

                <Border x:Name="ElevationBanner" Background="{DynamicResource InfoBgBrush}"
                        BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyMuted}"
                                   Margin="12,0,0,0" TextWrapping="Wrap"
                                   Text="Certaines mesures (températures, priorité de processus) nécessitent l'élévation des privilèges. Relancez GameBoost en administrateur depuis la page Paramètres pour les activer." />
                    </Grid>
                </Border>

                <TextBlock Text="JEU CONCERNÉ" Style="{StaticResource Label}" Margin="0,20,0,8" />
                <ComboBox x:Name="GameCombo" Style="{StaticResource Combo}" DisplayMemberPath="Label"
                          SelectionChanged="OnGameSelectionChanged"
                          ToolTip="Choisissez le jeu à optimiser, ou laissez « Aucun jeu spécifique » pour un boost général" />
                <TextBlock x:Name="ProfileHint" Text="" Style="{StaticResource Caption}" Margin="0,7,0,0" />

                <TextBlock Text="APPLICATIONS À FERMER" Style="{StaticResource Label}" Margin="0,20,0,6" />
                <TextBlock x:Name="ProcessCountText" Text="Lecture des processus…" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource CardFlat}" Margin="0,9,0,0" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="216" Focusable="False">
                        <StackPanel x:Name="ProcessListHost" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="OPTIMISATIONS" Style="{StaticResource Label}" Margin="0,22,0,12" />

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgClose" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Ferme uniquement les applications cochées dans la liste ci-dessus" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Fermer les applications sélectionnées" Style="{StaticResource Body}" />
                        <TextBlock Text="Libère le processeur et la mémoire pendant la session."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgGameMode" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Active le Mode Jeu Windows (registre) : l'ancienne valeur est restaurée à la fin de la session" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Activer le Mode Jeu Windows" Style="{StaticResource Body}" />
                        <TextBlock Text="Windows priorise les jeux et coupe les notifications."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgPower" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Bascule temporairement vers le plan « Hautes performances » : l'ancien plan est restauré à la fin de la session" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Plan d'alimentation temporaire (Hautes performances)" Style="{StaticResource Body}" />
                        <TextBlock Text="Empêche la réduction de fréquence pendant la session."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgMemory" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Vide la mémoire des applications en arrière-plan : elles la réclameront à nouveau quand vous les utiliserez" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Libérer la mémoire vive en arrière-plan" Style="{StaticResource Body}" />
                        <TextBlock Text="Hors applications protégées et hors jeu."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgProfile" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Modifie le fichier de configuration du jeu (une copie de sauvegarde est créée, restaurée à la fin)" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Appliquer le profil actif du jeu" Style="{StaticResource Body}" />
                        <TextBlock Text="Résolution, qualité, V-Sync selon le profil choisi."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgOverlay" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Affiche les FPS et les températures pendant la session : le réglage est restauré à la fin" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Afficher l'overlay FPS" Style="{StaticResource Body}" />
                        <TextBlock Text="Compteur affiché à l'écran pendant le jeu."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgTemp" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                 
                                  ToolTip="Action non réversible : les fichiers temporaires supprimés de plus de 48 heures ne peuvent pas être récupérés" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Nettoyer les fichiers temporaires > 48 h" Style="{StaticResource Body}" />
                        <TextBlock Text="Désactivé par défaut : suppression définitive des fichiers de plus de 48 heures."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StepBPanel" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="2. Résumé" Style="{StaticResource H2}" />
                <TextBlock Text="GameBoost va effectuer les optimisations suivantes :"
                           Style="{StaticResource H3}" Margin="0,16,0,0" TextWrapping="Wrap" />
                <TextBlock Text="Rien n'est encore modifié sur votre PC. Vérifiez la liste ci-dessous avant d'appliquer."
                           Style="{StaticResource BodyMuted}" Margin="0,8,0,0" />
                <StackPanel x:Name="SummaryHost" Margin="0,16,0,0" />
                <CheckBox x:Name="UnderstoodCheck" Content="J'ai compris" Style="{StaticResource Check}"
                          Checked="OnUnderstoodChanged" Unchecked="OnUnderstoodChanged"
                          ToolTip="Confirmez que vous avez lu le résumé avant l'application des modifications" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StepCPanel" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="3. Exécution" Style="{StaticResource H2}" />
                <ProgressBar x:Name="RunProgress" Style="{StaticResource SlimProgress}" Margin="0,16,0,0" />
                <TextBlock x:Name="RunLabel" Text="En attente…" Style="{StaticResource BodyMuted}" Margin="0,10,0,0" />

                <TextBlock x:Name="ResultsTitle" Text="Résultats" Style="{StaticResource H3}"
                           Margin="0,24,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="ResultsHost" Margin="0,12,0,0" />

                <TextBlock x:Name="BackupsTitle" Text="Sauvegardes créées" Style="{StaticResource H3}"
                           Margin="0,22,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="BackupsHost" Margin="0,10,0,0" />

                <TextBlock x:Name="AppliedTitle" Text="Optimisations appliquées" Style="{StaticResource H3}"
                           Margin="0,22,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="AppliedHost" Margin="0,10,0,0" />

                <Border x:Name="RestorePanel" Style="{StaticResource CardFlat}" Margin="0,22,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Restauration" Style="{StaticResource H3}" />
                        <StackPanel x:Name="RestoreHost" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <StackPanel x:Name="FooterA" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="OnCloseClick"
                        ToolTip="Fermer l'assistant sans rien modifier" />
                <Button x:Name="SummaryButton" Content="Voir le résumé" Style="{StaticResource AccentButton}"
                        Click="OnSummaryClick" Margin="12,0,0,0"
                        ToolTip="Afficher la liste exacte des modifications avant toute application" />
            </StackPanel>

            <StackPanel x:Name="FooterB" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22" Visibility="Collapsed">
                <Button Content="Retour" Style="{StaticResource SecondaryButton}" Click="OnBackClick"
                        ToolTip="Revenir à la configuration" />
                <Button Content="Annuler" Style="{StaticResource GhostButton}" Click="OnCloseClick"
                        Margin="12,0,0,0" ToolTip="Fermer l'assistant sans rien modifier" />
                <Button x:Name="ApplyButton" Content="APPLIQUER" Style="{StaticResource AccentButton}"
                        Click="OnApplyClick" Margin="12,0,0,0"
                        ToolTip="Appliquer les optimisations listées dans le résumé" />
            </StackPanel>

            <StackPanel x:Name="FooterC" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22" Visibility="Collapsed">
                <Button x:Name="EndSessionButton" Content="TERMINER LA SESSION ET RESTAURER"
                        Style="{StaticResource DangerButton}" Click="OnEndSessionClick"
                        ToolTip="Remettre l'alimentation, le mode jeu, les priorités et l'overlay dans l'état d'origine" />
                <Button x:Name="CloseButton" Content="Fermer" Style="{StaticResource SecondaryButton}"
                        Click="OnCloseClick" Margin="12,0,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
