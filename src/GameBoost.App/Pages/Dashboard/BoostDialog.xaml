<Window x:Class="GameBoost.App.Pages.Dashboard.BoostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameBoost.App.Localization"
        Title="{loc:Text Bdlg_Title}"
        Width="800" Height="780" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                      GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgTitleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid Margin="20,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Bdlg_Header}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Bdlg_HeaderHint}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="OnCloseClick"
                        FontFamily="{StaticResource IconFont}" FontSize="11" ToolTip="{loc:Text Bdlg_CloseTip}">
                    <TextBlock Text="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="StepAPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="{loc:Text Bdlg_StepConfig}" Style="{StaticResource H2}" />

                <Border x:Name="ElevationBanner" Background="{DynamicResource InfoBgBrush}"
                        BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyMuted}"
                                   Margin="12,0,0,0" TextWrapping="Wrap"
                                   Text="{loc:Text Bdlg_ElevationNote}" />
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Text Bdlg_GameLabel}" Style="{StaticResource Label}" Margin="0,20,0,8" />
                <ComboBox x:Name="GameCombo" Style="{StaticResource Combo}" DisplayMemberPath="Label"
                          SelectionChanged="OnGameSelectionChanged"
                          ToolTip="{loc:Text Bdlg_GameComboTip}" />
                <TextBlock x:Name="ProfileHint" Text="" Style="{StaticResource Caption}" Margin="0,7,0,0" />

                <TextBlock Text="{loc:Text Bdlg_CloseAppsLabel}" Style="{StaticResource Label}" Margin="0,20,0,6" />
                <TextBlock x:Name="ProcessCountText" Text="{loc:Text Bdlg_ReadingProcesses}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource CardFlat}" Margin="0,9,0,0" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="216" Focusable="False">
                        <StackPanel x:Name="ProcessListHost" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{loc:Text Bdlg_OptimizationsLabel}" Style="{StaticResource Label}" Margin="0,22,0,12" />

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgClose" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_CloseToggleTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_CloseApps}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_CloseAppsSub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgGameMode" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_GameModeTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_GameMode}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_GameModeSub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgPower" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_PowerTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_PowerPlan}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_PowerSub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgMemory" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_MemoryTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_FreeMemory}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_FreeMemorySub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgProfile" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_ProfileTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_ApplyProfile}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_ApplyProfileSub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgOverlay" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_OverlayTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_ShowFpsOverlay}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_ShowFpsOverlaySub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="TgTemp" Style="{StaticResource Toggle}" VerticalAlignment="Top"
                                  
                                  ToolTip="{loc:Text Bdlg_TempTip}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Text Bdlg_CleanTemp}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Text Bdlg_CleanTempSub}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StepBPanel" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="{loc:Text Bdlg_StepSummary}" Style="{StaticResource H2}" />
                <TextBlock Text="{loc:Text Bdlg_SummaryIntro}"
                           Style="{StaticResource H3}" Margin="0,16,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Text Bdlg_SummaryNote}"
                           Style="{StaticResource BodyMuted}" Margin="0,8,0,0" />
                <StackPanel x:Name="SummaryHost" Margin="0,16,0,0" />
                <CheckBox x:Name="UnderstoodCheck" Content="{loc:Text Bdlg_Understood}" Style="{StaticResource Check}"
                          Checked="OnUnderstoodChanged" Unchecked="OnUnderstoodChanged"
                          ToolTip="{loc:Text Bdlg_UnderstoodTip}" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StepCPanel" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,12">
                <TextBlock Text="{loc:Text Bdlg_StepRun}" Style="{StaticResource H2}" />
                <ProgressBar x:Name="RunProgress" Style="{StaticResource SlimProgress}" Margin="0,16,0,0" />
                <TextBlock x:Name="RunLabel" Text="{loc:Text Bdlg_Waiting}" Style="{StaticResource BodyMuted}" Margin="0,10,0,0" />

                <TextBlock x:Name="ResultsTitle" Text="{loc:Text Bdlg_Results}" Style="{StaticResource H3}"
                           Margin="0,24,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="ResultsHost" Margin="0,12,0,0" />

                <TextBlock x:Name="BackupsTitle" Text="{loc:Text Bdlg_Backups}" Style="{StaticResource H3}"
                           Margin="0,22,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="BackupsHost" Margin="0,10,0,0" />

                <TextBlock x:Name="AppliedTitle" Text="{loc:Text Bdlg_Applied}" Style="{StaticResource H3}"
                           Margin="0,22,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="AppliedHost" Margin="0,10,0,0" />

                <Border x:Name="RestorePanel" Style="{StaticResource CardFlat}" Margin="0,22,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Bdlg_Restore}" Style="{StaticResource H3}" />
                        <StackPanel x:Name="RestoreHost" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <StackPanel x:Name="FooterA" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22">
                <Button Content="{loc:Text Bdlg_Cancel}" Style="{StaticResource SecondaryButton}" Click="OnCloseClick"
                        ToolTip="{loc:Text Bdlg_CancelTip}" />
                <Button x:Name="SummaryButton" Content="{loc:Text Bdlg_SeeSummary}" Style="{StaticResource AccentButton}"
                        Click="OnSummaryClick" Margin="12,0,0,0"
                        ToolTip="{loc:Text Bdlg_SeeSummaryTip}" />
            </StackPanel>

            <StackPanel x:Name="FooterB" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22" Visibility="Collapsed">
                <Button Content="{loc:Text Bdlg_Back}" Style="{StaticResource SecondaryButton}" Click="OnBackClick"
                        ToolTip="{loc:Text Bdlg_BackTip}" />
                <Button Content="{loc:Text Bdlg_Cancel}" Style="{StaticResource GhostButton}" Click="OnCloseClick"
                        Margin="12,0,0,0" ToolTip="{loc:Text Bdlg_CancelTip}" />
                <Button x:Name="ApplyButton" Content="{loc:Text Bdlg_Apply}" Style="{StaticResource AccentButton}"
                        Click="OnApplyClick" Margin="12,0,0,0"
                        ToolTip="{loc:Text Bdlg_ApplyTip}" />
            </StackPanel>

            <StackPanel x:Name="FooterC" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,12,24,22" Visibility="Collapsed">
                <Button x:Name="EndSessionButton" Content="{loc:Text Bdlg_EndSession}"
                        Style="{StaticResource DangerButton}" Click="OnEndSessionClick"
                        ToolTip="{loc:Text Bdlg_EndSessionTip}" />
                <Button x:Name="CloseButton" Content="{loc:Text Bdlg_Close}" Style="{StaticResource SecondaryButton}"
                        Click="OnCloseClick" Margin="12,0,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
