<UserControl x:Class="GameBoost.App.Pages.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameBoost.App.Localization"
             Loaded="OnLoaded">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Text Sto_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Sto_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Top" Click="OnRefreshClick"
                    ToolTip="{loc:Text Sto_RefreshTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{loc:Text Sto_Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
            <TextBlock Text="{loc:Text Sto_Loading}"
                       Style="{StaticResource BodyMuted}" Margin="0,9,0,0" />
            <TextBlock Text="{loc:Text Sto_LoadingNote}"
                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel x:Name="AlertHost" Grid.Row="2" />

        <StackPanel x:Name="DisksPanel" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="DisksEmpty" Text="{loc:Text Sto_Empty}" Style="{StaticResource BodyMuted}"
                       Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Sto_TipsTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:Text Sto_Tip1}"
                           Style="{StaticResource Body}" Margin="0,12,0,0" />
                <TextBlock Text="{loc:Text Sto_Tip2}"
                           Style="{StaticResource Body}" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Text Sto_Tip3}"
                           Style="{StaticResource Body}" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Text Sto_Tip4}"
                           Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
