<UserControl x:Class="GameBoost.App.Pages.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Stockage" Style="{StaticResource H1}" />
                <TextBlock Text="Espace libre, état SMART et températures de vos disques"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Top" Click="OnRefreshClick"
                    ToolTip="Relancer l'analyse complète des disques : températures, santé SMART et débit d'essai. Environ 3 secondes.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Actualiser" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
            <TextBlock Text="Analyse des disques (températures, santé, débits)…"
                       Style="{StaticResource BodyMuted}" Margin="0,9,0,0" />
            <TextBlock Text="L'analyse prend jusqu'à 3 secondes : elle relève les compteurs SMART et mesure un débit d'essai."
                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel x:Name="AlertHost" Grid.Row="2" />

        <StackPanel x:Name="DisksPanel" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="DisksEmpty" Text="Aucun disque détecté." Style="{StaticResource BodyMuted}"
                       Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Conseils" Style="{StaticResource H3}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="En dessous de 10 % d'espace libre, Windows et les jeux manquent de place pour leurs mises à jour et leur cache : les téléchargements échouent ou ralentissent."
                           Style="{StaticResource Body}" Margin="0,12,0,0" />
                <TextBlock Text="Un SSD rempli à plus de 90 % perd en performance : gardez une marge libre, surtout sur le disque qui contient Windows."
                           Style="{StaticResource Body}" Margin="0,8,0,0" />
                <TextBlock Text="Les températures et l'état SMART ne sont lus qu'avec les droits administrateur : sans eux, ces valeurs s'affichent comme indisponibles."
                           Style="{StaticResource Body}" Margin="0,8,0,0" />
                <TextBlock Text="Ces lignes décrivent le fonctionnement normal du stockage. GameBoost ne modifie aucun de vos disques."
                           Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
