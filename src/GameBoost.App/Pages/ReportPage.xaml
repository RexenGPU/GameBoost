<UserControl x:Class="GameBoost.App.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Rapports" Style="{StaticResource H1}" />
                <TextBlock Text="Export HTML de vos analyses et de vos sessions, lisible dans n'importe quel navigateur."
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource AccentButton}" Click="OnExportAnalysisClick"
                        ToolTip="Reprend la dernière analyse enregistrée et la met en forme dans un fichier HTML.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exporter le dernier rapport d'analyse" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OnExportSessionsClick" Margin="10,0,0,0"
                        ToolTip="Exporte les 50 dernières sessions enregistrées dans un fichier HTML.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Exporter les sessions" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Margin="10,0,0,0"
                        ToolTip="Ouvre le dossier qui contient les fichiers HTML générés.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ouvrir le dossier des rapports" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="NoAnalysisPanel" Grid.Row="1" Style="{StaticResource Card}"
                Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Lancez d'abord une analyse : aucun rapport n'est enregistré sur ce PC pour l'instant."
                           Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGoAnalysisClick" Margin="16,0,0,0"
                        ToolTip="Ouvre la page Analyse pour lancer une première vérification.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Aller à l'analyse" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ExportResultPanel" Grid.Row="2" Style="{StaticResource CardFlat}"
                Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ExportResultTitle" Text="Fichier généré" Style="{StaticResource Label}" />
                <TextBlock x:Name="ExportResultPath" Text="" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnOpenResultClick"
                            ToolTip="Ouvre le fichier généré dans le navigateur par défaut.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ouvrir" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Margin="10,0,0,0"
                            ToolTip="Ouvre le dossier des rapports.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Dossier" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Fichiers générés" Style="{StaticResource H2}" />
                    <Button Style="{StaticResource GhostButton}" Click="OnRefreshClick" HorizontalAlignment="Right"
                            ToolTip="Relit le dossier des rapports.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Actualiser" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="FilesFolderText" Text="" Style="{StaticResource Caption}" Margin="0,5,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nom du fichier" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="Date" Style="{StaticResource Label}" Width="130" />
                    <TextBlock Grid.Column="2" Text="Taille" Style="{StaticResource Label}" Width="90"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Actions" Style="{StaticResource Label}" Width="150"
                               HorizontalAlignment="Right" Margin="12,0,0,0" />
                </Grid>

                <ScrollViewer x:Name="FilesScroll" Margin="0,8,0,0" MaxHeight="330"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="EmptyFilesText"
                                   Text="Aucun rapport HTML pour le moment : utilisez les boutons ci-dessus pour en créer un."
                                   Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                        <StackPanel x:Name="FilesPanel" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Ce que contient un rapport" Style="{StaticResource H2}" />
                <TextBlock Text="Chaque fichier est autonome : aucune connexion Internet n'est nécessaire pour le lire."
                           Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="Configuration" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" : processeur, carte graphique, mémoire, Windows, écrans et disques." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="Problèmes détectés" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" : chaque vérification avec sa gravité et sa valeur mesurée." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="• " /><Run Text="Recommandations" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" : les étapes à suivre pour corriger les points signalés." />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="Optimisations appliquées" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" : ce qui a été modifié lors des sessions enregistrées." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="Mesures avant / après" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" : comparaison de deux sessions lorsque vous en avez au moins deux." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Le rapport est un simple fichier HTML : vous pouvez l'imprimer en PDF depuis votre navigateur." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
