<UserControl x:Class="GameBoost.App.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls"
             xmlns:loc="clr-namespace:GameBoost.App.Localization">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Text Rep_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Rep_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource AccentButton}" Click="OnExportAnalysisClick"
                        ToolTip="{loc:Text Rep_ExportAnalysisTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Rep_ExportAnalysis}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OnExportSessionsClick" Margin="10,0,0,0"
                        ToolTip="{loc:Text Rep_ExportSessionsTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Rep_ExportSessions}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Margin="10,0,0,0"
                        ToolTip="{loc:Text Rep_OpenFolderTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Rep_OpenReportsFolder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="NoAnalysisPanel" Grid.Row="1" Style="{StaticResource Card}"
                Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{loc:Text Rep_NoAnalysisNote}"
                           Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGoAnalysisClick" Margin="16,0,0,0"
                        ToolTip="{loc:Text Rep_GoAnalysisTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Rep_GoAnalysis}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ExportResultPanel" Grid.Row="2" Style="{StaticResource CardFlat}"
                Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ExportResultTitle" Text="{loc:Text Rep_GeneratedFile}" Style="{StaticResource Label}" />
                <TextBlock x:Name="ExportResultPath" Text="" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnOpenResultClick"
                            ToolTip="{loc:Text Rep_OpenResultTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Rep_Open}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Margin="10,0,0,0"
                            ToolTip="{loc:Text Rep_OpenReportsFolderTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Rep_Folder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{loc:Text Rep_FilesTitle}" Style="{StaticResource H2}" />
                    <Button Style="{StaticResource GhostButton}" Click="OnRefreshClick" HorizontalAlignment="Right"
                            ToolTip="{loc:Text Rep_RefreshTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Rep_Refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="FilesFolderText" Text="" Style="{StaticResource Caption}" Margin="0,5,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text Rep_ColumnName}" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="{loc:Text Rep_ColumnDate}" Style="{StaticResource Label}" Width="130" />
                    <TextBlock Grid.Column="2" Text="{loc:Text Rep_ColumnSize}" Style="{StaticResource Label}" Width="90"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{loc:Text Rep_ColumnActions}" Style="{StaticResource Label}" Width="150"
                               HorizontalAlignment="Right" Margin="12,0,0,0" />
                </Grid>

                <ScrollViewer x:Name="FilesScroll" Margin="0,8,0,0" MaxHeight="330"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="EmptyFilesText"
                                   Text="{loc:Text Rep_EmptyFiles}"
                                   Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                        <StackPanel x:Name="FilesPanel" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Text Rep_ContentsTitle}" Style="{StaticResource H2}" />
                <TextBlock Text="{loc:Text Rep_ContentsNote}"
                           Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="{loc:Text Rep_ItemConfig}" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="{loc:Text Rep_ItemConfigDesc}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="{loc:Text Rep_ItemIssues}" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="{loc:Text Rep_ItemIssuesDesc}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="• " /><Run Text="{loc:Text Rep_ItemRecommendations}" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="{loc:Text Rep_ItemRecommendationsDesc}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="{loc:Text Rep_ItemOptimizations}" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="{loc:Text Rep_ItemOptimizationsDesc}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7">
                            <Run Text="• " /><Run Text="{loc:Text Rep_ItemBeforeAfter}" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="{loc:Text Rep_ItemBeforeAfterDesc}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="{loc:Text Rep_PrintNote}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
