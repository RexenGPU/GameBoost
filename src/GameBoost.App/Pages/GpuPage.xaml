<UserControl x:Class="GameBoost.App.Pages.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls"
             xmlns:loc="clr-namespace:GameBoost.App.Localization"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GPU" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Gpu_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Top" Click="OnRefreshClick"
                    ToolTip="{loc:Text Gpu_RefreshTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{loc:Text Gpu_Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
            <TextBlock Text="{loc:Text Gpu_Loading}" Style="{StaticResource BodyMuted}" Margin="0,9,0,0" />
        </StackPanel>

        <Border x:Name="EmptyPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{loc:Text Gpu_EmptyTitle}" Style="{StaticResource H3}" />
                <TextBlock Text="{loc:Text Gpu_EmptyNote}"
                           Style="{StaticResource BodyMuted}" Margin="0,8,0,0" />
                <Button Content="{loc:Text Gpu_Refresh}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        Margin="0,14,0,0" Click="OnRefreshClick"
                        ToolTip="{loc:Text Gpu_EmptyRefreshTip}" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="ContentPanel" Grid.Row="3" Visibility="Collapsed">
            <Border x:Name="GpuBanner" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuNameText" Text="—" Style="{StaticResource H2}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel x:Name="VendorHost" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="BannerFields" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Text Gpu_LiveTitle}" Style="{StaticResource H2}" Margin="0,26,0,0" />
            <TextBlock Text="{loc:Text Gpu_LiveNote}"
                       Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            <UniformGrid x:Name="LiveGrid" Columns="4" Margin="0,14,0,0">
                <controls:StatCard x:Name="TempCard" Title="{loc:Text Gpu_TempTitle}" Icon="&#xE7C3;" Unit="°C" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_TempTip}" />
                <controls:StatCard x:Name="LoadCard" Title="{loc:Text Gpu_LoadTitle}" Icon="&#xE7F4;" Unit="%" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_LoadTip}" />
                <controls:StatCard x:Name="ClockCard" Title="{loc:Text Gpu_ClockTitle}" Icon="&#xE74E;" Unit="MHz" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_ClockTip}" />
                <controls:StatCard x:Name="FanCard" Title="{loc:Text Gpu_FanTitle}" Icon="&#xE706;" Unit="%" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_FanTip}" />
            </UniformGrid>
            <UniformGrid x:Name="VramGrid" Columns="2">
                <controls:StatCard x:Name="VramUsedCard" Title="{loc:Text Gpu_VramUsedTitle}" Icon="&#xE77B;" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_VramUsedTip}" />
                <controls:StatCard x:Name="VramTotalCard" Title="{loc:Text Gpu_VramTotalTitle}" Icon="&#xE7C5;" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Gpu_VramTotalTip}" />
            </UniformGrid>

            <TextBlock Text="{loc:Text Gpu_TechTitle}" Style="{StaticResource H2}" Margin="0,26,0,0" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <WrapPanel x:Name="TechPanel" />
                    <TextBlock x:Name="TechUnavailable" Text="" Style="{StaticResource BodyMuted}"
                               Margin="0,14,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TechNotes" Text="" Style="{StaticResource Caption}"
                               Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardFlat}" Margin="0,12,0,0"
                    Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                           Text="{loc:Text Gpu_TechNote}" />
            </Border>

            <TextBlock Text="{loc:Text Gpu_AdaptersTitle}" Style="{StaticResource H2}" Margin="0,26,0,0" />
            <TextBlock Text="{loc:Text Gpu_AdaptersNote}"
                       Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            <StackPanel x:Name="AdaptersList" Margin="0,14,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
