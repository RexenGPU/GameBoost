<UserControl x:Class="GameBoost.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:games="clr-namespace:GameBoost.App.Pages.Games"
             xmlns:loc="clr-namespace:GameBoost.App.Localization">
    <UserControl.Resources>
        <games:GameIconConverter x:Key="GameIcon" />
        <Style x:Key="ScanProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" Width="140"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="slide" X="-140" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="slide"
                                                             Storyboard.TargetProperty="X"
                                                             From="-140" To="900"
                                                             Duration="0:0:1.5"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameCardBorder" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Text Games_Title}" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                           Text="{loc:Text Games_Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ScanButton" Style="{StaticResource AccentButton}"
                        Click="OnScanClick" Margin="0,0,10,0"
                        ToolTip="{loc:Text Games_ScanTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Games_Scan}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource SecondaryButton}"
                        Click="OnAddExeClick"
                        ToolTip="{loc:Text Games_AddTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Games_AddExe}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSearchChanged"
                         ToolTip="{loc:Text Games_SearchTip}" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsHitTestVisible="False" />
            </Grid>
            <ComboBox x:Name="PlatformFilter" Grid.Column="1" Margin="0,0,10,0"
                      SelectionChanged="OnPlatformChanged"
                      ToolTip="{loc:Text Games_PlatformTip}" />
            <TextBlock x:Name="ResultCount" Grid.Column="2" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="{loc:Text Games_LocalNote}" />
        </Grid>

        <ProgressBar x:Name="ScanProgress" Grid.Row="2" Margin="0,12,0,0"
                     Style="{StaticResource ScanProgress}"
                     IsIndeterminate="True" Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="640" Focusable="False">
                    <ItemsControl x:Name="GamesList" Margin="0,0,12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GameCardBorder}" Width="330"
                                        MouseLeftButtonDown="OnCardClick" Tag="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="9" />
                                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Width="32" Height="32" Stretch="Uniform"
                                                       Source="{Binding Game.IconPath, Converter={StaticResource GameIcon}}"
                                                       Visibility="{Binding Game.IconPath, Converter={StaticResource NullToCollapsed}}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Game.Name}" Style="{StaticResource H3}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource CardFlat}" Padding="7,2"
                                                        CornerRadius="6" HorizontalAlignment="Left" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding PlatformLabel}" Style="{StaticResource Caption}" />
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="6" Padding="7,3" VerticalAlignment="Top"
                                                    Visibility="{Binding RunningLabel, Converter={StaticResource NullToCollapsed}}"
                                                    ToolTip="{loc:Text Games_RunningTip}">
                                                <TextBlock Text="{Binding RunningLabel}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource OnAccentBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding InstallPathLabel}" Style="{StaticResource Mono}"
                                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InstallPathLabel}" />

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Text Games_LastLaunch}" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding LastLaunchLabel}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{loc:Text Games_Size}" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,10,0,8"
                                                   Background="{DynamicResource BorderBrush}" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}" Padding="12,7"
                                                    Click="OnLaunchClick" Tag="{Binding Game}"
                                                    IsEnabled="{Binding CanLaunch}"
                                                    ToolTip="{Binding LaunchToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Text Games_Launch}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"
                                                    Click="OnProfilesClick"
                                                    ToolTip="{loc:Text Games_ProfilesBtnTip}">
                                                <TextBlock Text="{loc:Text Games_ProfilesBtn}" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"
                                                    Click="OnOpenFolderClick" Tag="{Binding Game}"
                                                    ToolTip="{loc:Text Games_OpenFolderTip}">
                                                <TextBlock Text="{loc:Text Games_OpenFolderBtn}" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="8,7" Margin="6,0,0,0"
                                                    Click="OnRemoveClick" Tag="{Binding Game}"
                                                    ToolTip="{loc:Text Games_RemoveTip}">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,60,0,0" MaxWidth="420">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="34"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Text Games_EmptyTitle}" Style="{StaticResource H2}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{loc:Text Games_EmptyHint}"
                               Style="{StaticResource BodyMuted}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Click="OnScanClick"
                            ToolTip="{loc:Text Games_EmptyScanTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Games_Scan}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                <StackPanel x:Name="DetailPlaceholder">
                    <TextBlock Text="{loc:Text Games_DetailTitle}" Style="{StaticResource Label}" />
                    <TextBlock Text="{loc:Text Games_DetailHint}"
                               Style="{StaticResource BodyMuted}" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Game.Name}" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Column="1" Style="{StaticResource CardFlat}" Padding="8,3"
                                CornerRadius="7" VerticalAlignment="Top">
                            <TextBlock Text="{Binding PlatformLabel}" Style="{StaticResource Caption}" />
                        </Border>
                    </Grid>

                    <Border x:Name="RunningBadge" Background="{DynamicResource AccentBrush}" CornerRadius="7"
                            Padding="9,4" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="Collapsed"
                            ToolTip="{loc:Text Games_RunningBadgeTip}">
                        <TextBlock Text="{loc:Text Games_RunningBadge}"
                                   Foreground="{DynamicResource OnAccentBrush}" Style="{StaticResource Caption}" />
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,9">
                            <TextBlock Text="{loc:Text Games_InstallDir}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding InstallPathLabel}" Style="{StaticResource Mono}"
                                       TextWrapping="Wrap" ToolTip="{Binding InstallPathLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,9">
                            <TextBlock Text="{loc:Text Games_Executable}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ExecutableLabel}" Style="{StaticResource Mono}"
                                       TextWrapping="Wrap" ToolTip="{Binding ExecutableLabel}" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Text Games_InstallSize}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Body}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Text Games_LastLaunch}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding LastLaunchLabel}" Style="{StaticResource Body}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,0,0,9">
                            <TextBlock Text="{loc:Text Games_InternalId}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Game.Id}" Style="{StaticResource Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="{loc:Text Games_OverlayForGame}"
                                       Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <ToggleButton x:Name="OverlayToggle" Style="{StaticResource Toggle}"
                                              Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                              ToolTip="{loc:Text Games_OverlayTip}" />
                                <TextBlock x:Name="OverlayLabel" Text="{loc:Text Games_OverlayEnabled}"
                                           Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                    <TextBlock Text="{loc:Text Games_LaunchArgs}" Style="{StaticResource Label}" />
                    <TextBox x:Name="ArgsBox" Margin="0,6,0,0" MinHeight="34"
                             ToolTip="{loc:Text Games_ArgsTip}" />
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OnSaveGameClick"
                            ToolTip="{loc:Text Games_SaveTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Games_Save}" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,16,0,12" Background="{DynamicResource BorderBrush}" />

                    <TextBlock Text="{loc:Text Games_KnownConfig}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="ConfigText" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />

                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="OnProfilesClick"
                            ToolTip="{loc:Text Games_ViewProfilesTip}">
                        <TextBlock Text="{loc:Text Games_ViewProfiles}" />
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
