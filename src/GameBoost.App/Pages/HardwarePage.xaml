<UserControl x:Class="GameBoost.App.Pages.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameBoost.App.Localization"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Text Hw_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Hw_Subtitle}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Top" Click="OnRefreshClick"
                    ToolTip="{loc:Text Hw_RefreshTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{loc:Text Hw_Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="ElevationBanner" Grid.Row="1" Style="{StaticResource CardFlat}" Margin="0,16,0,0"
                Visibility="Collapsed" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text Hw_ElevationBanner}"
                               Style="{StaticResource Body}" />
                    <TextBlock Text="{loc:Text Hw_ElevationBannerNote}"
                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="{loc:Text Hw_ElevationHelp}" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="OnElevationHelpClick"
                        ToolTip="{loc:Text Hw_ElevationHelpTip}" />
            </Grid>
        </Border>

        <StackPanel x:Name="LoadingPanel" Grid.Row="2" Margin="0,18,0,0">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
            <TextBlock Text="{loc:Text Hw_Loading}" Style="{StaticResource BodyMuted}" Margin="0,9,0,0" />
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="3" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="LeftColumn" Grid.Column="0" Margin="0,0,7,0">
                <Border x:Name="CpuCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F0;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_CpuTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="CpuFields" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="RamCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_RamTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="RamFields" Margin="0,8,0,0" />
                        <TextBlock Text="{loc:Text Hw_RamModulesTitle}" Style="{StaticResource Label}" Margin="0,18,0,8" />
                        <StackPanel x:Name="RamModules" />
                    </StackPanel>
                </Border>

                <Border x:Name="MotherboardCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_MotherboardTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="MotherboardFields" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="RightColumn" Grid.Column="1" Margin="7,0,0,0">
                <Border x:Name="SystemCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_SystemTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="SystemFields" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="DisplaysCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_DisplaysTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DisplaysEmpty" Text="{loc:Text Hw_DisplaysEmpty}" Style="{StaticResource BodyMuted}"
                                   Margin="0,10,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="DisplaysList" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="PeripheralsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_PeripheralsTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <TextBox x:Name="PeripheralSearch" Style="{StaticResource SearchBox}"
                                         VerticalContentAlignment="Center" TextChanged="OnPeripheralSearchChanged"
                                         ToolTip="{loc:Text Hw_PeripheralSearchTip}" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock x:Name="PeripheralCount" Grid.Column="1" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="PeripheralEmpty" Text="{loc:Text Hw_PeripheralsEmpty}"
                                   Style="{StaticResource BodyMuted}" Margin="0,12,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="PeripheralsList" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="GpuCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hw_GpuTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="GpuFields" Margin="0,8,0,0" />
                        <Button Content="{loc:Text Hw_OpenGpuPage}" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnOpenGpuClick"
                                ToolTip="{loc:Text Hw_OpenGpuPageTip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
