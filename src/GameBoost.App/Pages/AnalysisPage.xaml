<UserControl x:Class="GameBoost.App.Pages.AnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Analyse" Style="{StaticResource H1}" />
                <TextBlock Text="Vérifications automatiques de votre configuration"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="AnalyzeButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                    Click="OnAnalyzeClick" MinWidth="200" Height="48" VerticalAlignment="Top"
                    ToolTip="Exécute toutes les vérifications (matériel, températures, pilotes, disque, Windows). Rien n'est modifié pendant l'analyse, seules des lectures sont faites.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="ANALYSER" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="ProgressPanel" Grid.Row="1" Style="{StaticResource CardFlat}"
                Margin="0,14,0,0" Visibility="Collapsed"
                ToolTip="Progression de l'analyse en cours : l'étape et le détail affichés proviennent du moteur d'analyse.">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="StageText" Text="Analyse en cours…" Style="{StaticResource H3}" />
                    <TextBlock x:Name="PercentText" Text="0 %" Style="{StaticResource Mono}"
                               HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="ProgressFill" Style="{StaticResource SlimProgress}"
                             Minimum="0" Maximum="100" Margin="0,10,0,0" />
                <TextBlock x:Name="DetailText" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="SummaryPanel" Grid.Row="2" Style="{StaticResource Card}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource CardFlat}" Padding="11,6" CornerRadius="999"
                                ToolTip="Vérifications conformes : aucune action n'est nécessaire.">
                            <TextBlock x:Name="GoodCountText" Text="🟢 0 optimal" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource CardFlat}" Padding="11,6" CornerRadius="999" Margin="8,0,0,0"
                                ToolTip="Vérifications à surveiller : le système fonctionne mais peut être amélioré.">
                            <TextBlock x:Name="WarningCountText" Text="🟡 0 à surveiller" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource CardFlat}" Padding="11,6" CornerRadius="999" Margin="8,0,0,0"
                                ToolTip="Vérifications critiques : ces points limitent directement les performances.">
                            <TextBlock x:Name="CriticalCountText" Text="🔴 0 problèmes" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ReportDateText" Text="" Style="{StaticResource Caption}" Margin="0,9,0,0" />
                    <TextBlock x:Name="SummaryText" Text="" Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnRelaunchClick"
                            ToolTip="Relance une analyse complète pour repartir de zéro.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Relancer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportReportButton" Style="{StaticResource SecondaryButton}"
                            Click="OnExportReportClick" Margin="10,0,0,0" IsEnabled="False"
                            ToolTip="Génère un fichier HTML lisible dans votre navigateur, à partir du rapport affiché et de vos dernières sessions.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Générer un rapport" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ElevationPanel" Grid.Row="3" Style="{StaticResource Card}"
                Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ElevationText" Grid.Column="1" Text="" Style="{StaticResource Body}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnRelaunchElevatedClick"
                        Margin="16,0,0,0"
                        ToolTip="Redémarre GameBoost avec les droits administrateur, nécessaires pour appliquer certaines corrections système.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Relancer en administrateur" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Chip}" GroupName="analysisFilter" Content="Tous"
                             IsChecked="True" Tag="all" Checked="OnFilterChecked"
                             ToolTip="Affiche toutes les vérifications du rapport." />
                <RadioButton Style="{StaticResource Chip}" GroupName="analysisFilter" Content="Problèmes"
                             Tag="problems" Checked="OnFilterChecked" Margin="8,0,0,0"
                             ToolTip="N'affiche que les points à surveiller et les problèmes critiques." />
                <RadioButton Style="{StaticResource Chip}" GroupName="analysisFilter" Content="Optimal"
                             Tag="good" Checked="OnFilterChecked" Margin="8,0,0,0"
                             ToolTip="N'affiche que les vérifications déjà conformes." />
            </StackPanel>
            <TextBlock x:Name="FilterCountText" Grid.Column="1" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="ChecksScroll" Grid.Row="5" Margin="0,12,0,0" MaxHeight="500"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      ToolTip="Les vérifications sont triées par sévérité : problèmes critiques d'abord.">
            <StackPanel>
                <TextBlock x:Name="EmptyHintText" Text="Aucune analyse pour l'instant : cliquez sur ANALYSER pour obtenir un diagnostic complet de votre configuration."
                           Style="{StaticResource BodyMuted}" Margin="0,4,0,8" />
                <ItemsControl x:Name="ChecksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:HealthBadge Level="{Binding Level}" />
                                            <Border CornerRadius="999" Padding="9,3" Margin="10,0,0,0"
                                                    Background="{DynamicResource CardAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,9,0,0" />
                                        <TextBlock Text="{Binding CurrentValueLabel}" Style="{StaticResource Mono}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding CurrentValueLabel, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding ImpactLabel, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="Impact potentiel" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding ImpactLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding SolutionLabel, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="Solution" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding SolutionLabel}" Style="{StaticResource BodyMuted}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ManualLabel}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextFaintBrush}" Margin="0,9,0,0"
                                                   Visibility="{Binding ManualLabel, Converter={StaticResource NullToCollapsed}}" />
                                        <Border CornerRadius="8" Padding="11,9" Margin="0,10,0,0"
                                                Background="{DynamicResource CardAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding OutcomeLabel, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding BackupLabel}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource GoodBrush}" Margin="0,7,0,0"
                                                   Visibility="{Binding BackupLabel, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                                        <Button Content="{Binding AutoFixLabel}" Style="{StaticResource AccentButton}"
                                                Click="OnFixClick" Tag="{Binding}" MinWidth="190"
                                                Visibility="{Binding AutoFixLabel, Converter={StaticResource NullToCollapsed}}"
                                                ToolTip="Applique la correction proposée. GameBoost crée une sauvegarde lorsque Windows le permet." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoMatchText" Text="Aucune vérification ne correspond à ce filtre."
                           Style="{StaticResource BodyMuted}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ExportPanel" Grid.Row="6" Style="{StaticResource CardFlat}"
                Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Rapport HTML généré" Style="{StaticResource Label}" />
                <TextBlock x:Name="ExportPathText" Text="" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnOpenReportClick"
                            ToolTip="Ouvre le fichier HTML généré dans votre navigateur par défaut.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ouvrir le rapport" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Margin="10,0,0,0"
                            ToolTip="Ouvre le dossier contenant les rapports exportés.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ouvrir le dossier" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel x:Name="RecentSection" Grid.Row="7" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Dernières analyses" Style="{StaticResource H2}" />
            <TextBlock Text="Cliquez sur une analyse pour revoir son détail sans relancer de vérification."
                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
            <ScrollViewer MaxHeight="220" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardFlat}" Margin="0,0,0,8" Cursor="Hand"
                                    MouseLeftButtonUp="OnRecentClick" Tag="{Binding}"
                                    ToolTip="Recharge ce rapport dans la vue : aucune nouvelle analyse n'est lancée.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding CountersLabel}" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SummaryLabel}"
                                               Style="{StaticResource Caption}" Margin="18,0,0,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               MaxWidth="520" TextWrapping="Wrap" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
