<UserControl x:Class="GameBoost.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameBoost.App.Localization">
    <UserControl.Resources>
        <Style x:Key="ItemChip" TargetType="Border" BasedOn="{StaticResource CardFlat}">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="ToggleRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Text Settings_Title}" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                       Text="{loc:Text Settings_Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_General}" Style="{StaticResource H3}" />

                        <TextBlock Text="{loc:Text Settings_Language}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <ComboBox x:Name="LanguageCombo" Margin="0,6,0,0" SelectionChanged="OnLanguageChanged"
                                  ToolTip="{loc:Text Settings_LanguageTip}" />

                        <TextBlock Text="{loc:Text Settings_ThemeLabel}" Style="{StaticResource Label}" Margin="0,14,0,0" />
                        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" SelectionChanged="OnThemeChanged"
                                  ToolTip="{loc:Text Settings_ThemeTip}" />

                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,14,0,0"
                                  Content="{loc:Text Settings_StartWithWindows}"
                                  Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"
                                  ToolTip="{loc:Text Settings_StartWithWindowsTip}" />

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="StartElevatedToggle" Style="{StaticResource Toggle}"
                                          Checked="OnStartElevatedChanged" Unchecked="OnStartElevatedChanged"
                                          ToolTip="{loc:Text Settings_StartElevatedTip}" />
                            <TextBlock Text="{loc:Text Settings_StartElevated}" Style="{StaticResource Body}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnRelaunchAdminClick"
                                ToolTip="{loc:Text Settings_RelaunchAdminTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Settings_RelaunchAdmin}" />
                            </StackPanel>
                        </Button>

                        <CheckBox x:Name="NotificationsCheck" Margin="0,14,0,0"
                                  Content="{loc:Text Settings_Notifications}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged"
                                  ToolTip="{loc:Text Settings_NotificationsTip}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_AnalysisBoost}" Style="{StaticResource H3}" />

                        <TextBlock Text="{loc:Text Settings_IntervalLabel}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <ComboBox x:Name="IntervalCombo" Margin="0,6,0,0" SelectionChanged="OnIntervalChanged"
                                  ToolTip="{loc:Text Settings_IntervalTip}" />

                        <CheckBox x:Name="ConfirmBeforeBoostCheck" Margin="0,14,0,0"
                                  Content="{loc:Text Settings_ConfirmBoost}"
                                  Checked="OnConfirmBeforeBoostChanged" Unchecked="OnConfirmBeforeBoostChanged"
                                  ToolTip="{loc:Text Settings_ConfirmBoostTip}" />

                        <CheckBox x:Name="RelaunchClosedAppsCheck" Margin="0,9,0,0"
                                  Content="{loc:Text Settings_RelaunchClosed}"
                                  Checked="OnRelaunchClosedAppsChanged" Unchecked="OnRelaunchClosedAppsChanged"
                                  ToolTip="{loc:Text Settings_RelaunchClosedTip}" />

                        <CheckBox x:Name="ClearTempCheck" Margin="0,9,0,0"
                                  Content="{loc:Text Settings_ClearTemp}"
                                  Checked="OnClearTempChanged" Unchecked="OnClearTempChanged"
                                  ToolTip="{loc:Text Settings_ClearTempTip}" />

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="{loc:Text Settings_AutoCloseTitle}" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="{loc:Text Settings_AutoCloseNote}" />

                        <CheckBox x:Name="AutoCloseEnabledCheck" Margin="0,9,0,0"
                                  Content="{loc:Text Settings_AutoCloseEnable}"
                                  Checked="OnAutoCloseEnabledChanged" Unchecked="OnAutoCloseEnabledChanged"
                                  ToolTip="{loc:Text Settings_AutoCloseEnableTip}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AutoCloseBox" Grid.Column="0"
                                     ToolTip="{loc:Text Settings_AutoCloseBoxTip}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnAddAutoCloseClick"
                                    ToolTip="{loc:Text Settings_AddTip}">
                                <TextBlock Text="{loc:Text Settings_Add}" />
                            </Button>
                        </Grid>

                        <ComboBox x:Name="RunningPicker" Margin="0,8,0,0" SelectionChanged="OnRunningPicked"
                                  ToolTip="{loc:Text Settings_RunningPickerTip}" />

                        <ScrollViewer MaxHeight="140" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AutoCloseList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveAutoCloseClick"
                                                        ToolTip="{loc:Text Settings_RemoveTip}">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_ExclusionsTitle}" Style="{StaticResource H3}" />

                        <TextBlock Text="{loc:Text Settings_ExclusionsLabel}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="{loc:Text Settings_ExclusionsNote}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExclusionBox" Grid.Column="0"
                                     ToolTip="{loc:Text Settings_ExclusionBoxTip}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnAddExclusionClick"
                                    ToolTip="{loc:Text Settings_AddExclusionTip}">
                                <TextBlock Text="{loc:Text Settings_Add}" />
                            </Button>
                        </Grid>

                        <ScrollViewer MaxHeight="150" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ExclusionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveExclusionClick"
                                                        ToolTip="{loc:Text Settings_RemoveTip}">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="{loc:Text Settings_CustomFoldersLabel}" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="{loc:Text Settings_CustomFoldersNote}" />

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnAddFolderClick"
                                ToolTip="{loc:Text Settings_AddFolderTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Settings_AddFolder}" />
                            </StackPanel>
                        </Button>

                        <ScrollViewer MaxHeight="150" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FolderList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                           VerticalAlignment="Center" ToolTip="{Binding}" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveFolderClick"
                                                        ToolTip="{loc:Text Settings_RemoveFolderTip}">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_OverlayMonitoring}" Style="{StaticResource H3}" />

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="OverlayEnabledToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_OverlayEnabledTip}" />
                            <TextBlock Text="{loc:Text Settings_OverlayEnabled}" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowFpsToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_FpsTip}" />
                            <TextBlock Text="FPS" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowFrameTimeToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_FrameTimeTip}" />
                            <TextBlock Text="{loc:Text Settings_FrameTime}" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowCpuToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_CpuLoadTip}" />
                            <TextBlock Text="CPU" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowGpuToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_GpuLoadTip}" />
                            <TextBlock Text="GPU" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowRamToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_RamLoadTip}" />
                            <TextBlock Text="RAM" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowTempToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="{loc:Text Settings_TemperaturesTip}" />
                            <TextBlock Text="{loc:Text Settings_Temperatures}" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Text Settings_Opacity}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OpacityLabel" Grid.Column="1" Text="85 %"
                                       Style="{StaticResource Caption}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource Slider}" Minimum="30" Maximum="100"
                                Value="85" Margin="0,6,0,0" ValueChanged="OnOpacityChanged"
                                ToolTip="{loc:Text Settings_OpacityTip}" />

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <CheckBox x:Name="RecordSessionsCheck" Content="{loc:Text Settings_RecordSessions}"
                                  Checked="OnRecordSessionsChanged" Unchecked="OnRecordSessionsChanged"
                                  ToolTip="{loc:Text Settings_RecordSessionsTip}" />

                        <TextBlock Text="{loc:Text Settings_RetentionLabel}" Style="{StaticResource Label}" Margin="0,14,0,0" />
                        <ComboBox x:Name="RetentionCombo" Margin="0,6,0,0" SelectionChanged="OnRetentionChanged"
                                  ToolTip="{loc:Text Settings_RetentionTip}" />

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnPruneHistoryClick"
                                ToolTip="{loc:Text Settings_ApplyNowTip}">
                            <TextBlock Text="{loc:Text Settings_ApplyNow}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_BackupsLogs}" Style="{StaticResource H3}" />

                        <TextBlock Text="{loc:Text Settings_BackupLabel}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="{loc:Text Settings_BackupNote}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupBox" Grid.Column="0" TextChanged="OnBackupLocationChanged"
                                     ToolTip="{loc:Text Settings_BackupBoxTip}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnBrowseBackupClick"
                                    ToolTip="{loc:Text Settings_BrowseTip}">
                                <TextBlock Text="{loc:Text Settings_Browse}" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="OnOpenBackupClick"
                                    ToolTip="{loc:Text Settings_OpenBackupTip}">
                                <TextBlock Text="{loc:Text Settings_OpenFolder}" />
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Click="OnOpenLogsClick"
                                    ToolTip="{loc:Text Settings_OpenLogsTip}">
                                <TextBlock Text="{loc:Text Settings_OpenLogs}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="OnShowLogsClick"
                                    ToolTip="{loc:Text Settings_ShowLogsTip}">
                                <TextBlock Text="{loc:Text Settings_ShowLogs}" />
                            </Button>
                        </StackPanel>

                        <Border x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource CardFlat}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Text Settings_TodayLog}" Style="{StaticResource Label}" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Click="OnCopyLogsClick"
                                            ToolTip="{loc:Text Settings_CopyTip}">
                                        <TextBlock Text="{loc:Text Settings_Copy}" />
                                    </Button>
                                </Grid>
                                <ScrollViewer MaxHeight="280" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnTrimLogsClick"
                                ToolTip="{loc:Text Settings_TrimLogsTip}">
                            <TextBlock Text="{loc:Text Settings_TrimLogs}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Settings_About}" Style="{StaticResource H3}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{loc:Text Settings_Version}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="VersionText" Text="1.0.0" Style="{StaticResource Body}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,10,0,0"
                                   Text="{loc:Text Settings_PrivacyNote}" />
                        <Border Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Body}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{loc:Text Settings_HonestyNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
