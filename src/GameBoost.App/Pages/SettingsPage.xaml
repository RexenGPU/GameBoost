<UserControl x:Class="GameBoost.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ItemChip" TargetType="Border" BasedOn="{StaticResource CardFlat}">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="ToggleRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Paramètres" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                       Text="Réglages de GameBoost. Tout est enregistré sur ce PC, dans un fichier de configuration local." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Général" Style="{StaticResource H3}" />

                        <TextBlock Text="Thème de l'interface" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" SelectionChanged="OnThemeChanged"
                                  ToolTip="Apparence sombre ou claire de GameBoost" />

                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,14,0,0"
                                  Content="Démarrer avec Windows"
                                  Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"
                                  ToolTip="Ajoute GameBoost dans la clé de démarrage de votre compte Windows, sans créer de service" />

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="StartElevatedToggle" Style="{StaticResource Toggle}"
                                          Checked="OnStartElevatedChanged" Unchecked="OnStartElevatedChanged"
                                          ToolTip="Relance toujours GameBoost en administrateur au démarrage" />
                            <TextBlock Text="Démarrer en administrateur" Style="{StaticResource Body}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnRelaunchAdminClick"
                                ToolTip="Redémarre GameBoost avec les droits administrateur : températures, priorités de processus et santé SMART deviennent disponibles">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Relancer en administrateur maintenant" />
                            </StackPanel>
                        </Button>

                        <CheckBox x:Name="NotificationsCheck" Margin="0,14,0,0"
                                  Content="Notifications"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged"
                                  ToolTip="Affiche des messages quand une analyse ou un boost se termine" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Analyses &amp; Boost" Style="{StaticResource H3}" />

                        <TextBlock Text="Fréquence des analyses" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <ComboBox x:Name="IntervalCombo" Margin="0,6,0,0" SelectionChanged="OnIntervalChanged"
                                  ToolTip="Intervalle entre deux analyses automatiques de l'état du PC" />

                        <CheckBox x:Name="ConfirmBeforeBoostCheck" Margin="0,14,0,0"
                                  Content="Confirmer avant un boost"
                                  Checked="OnConfirmBeforeBoostChanged" Unchecked="OnConfirmBeforeBoostChanged"
                                  ToolTip="Demande une confirmation avant toute modification système" />

                        <CheckBox x:Name="RelaunchClosedAppsCheck" Margin="0,9,0,0"
                                  Content="Relancer les applications fermées"
                                  Checked="OnRelaunchClosedAppsChanged" Unchecked="OnRelaunchClosedAppsChanged"
                                  ToolTip="Rouvre automatiquement les applications fermées par le boost après la session de jeu" />

                        <CheckBox x:Name="ClearTempCheck" Margin="0,9,0,0"
                                  Content="Nettoyer les fichiers temporaires au boost"
                                  Checked="OnClearTempChanged" Unchecked="OnClearTempChanged"
                                  ToolTip="Supprime les fichiers temporaires : cette opération n'est pas réversible" />

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="Applications à fermer automatiquement" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="GameBoost fermera ces applications avant un boost pour libérer de la ressource." />

                        <CheckBox x:Name="AutoCloseEnabledCheck" Margin="0,9,0,0"
                                  Content="Activer la fermeture automatique"
                                  Checked="OnAutoCloseEnabledChanged" Unchecked="OnAutoCloseEnabledChanged"
                                  ToolTip="Autorise GameBoost à fermer les applications listées ci-dessous" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AutoCloseBox" Grid.Column="0"
                                     ToolTip="Nom du processus, par exemple chrome ou discord" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnAddAutoCloseClick"
                                    ToolTip="Ajouter cette application à la liste">
                                <TextBlock Text="Ajouter" />
                            </Button>
                        </Grid>

                        <ComboBox x:Name="RunningPicker" Margin="0,8,0,0" SelectionChanged="OnRunningPicked"
                                  ToolTip="Choisir une application en cours d'exécution pour pré-remplir le champ" />

                        <ScrollViewer MaxHeight="140" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AutoCloseList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveAutoCloseClick"
                                                        ToolTip="Retirer de la liste">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Exclusions &amp; dossiers" Style="{StaticResource H3}" />

                        <TextBlock Text="Exclusions" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="GameBoost n'agira jamais sur ces éléments : ni analyse de performance, ni fermeture, ni modification de leur priorité." />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExclusionBox" Grid.Column="0"
                                     ToolTip="Nom d'un processus ou d'un jeu à exclure" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnAddExclusionClick"
                                    ToolTip="Ajouter aux exclusions">
                                <TextBlock Text="Ajouter" />
                            </Button>
                        </Grid>

                        <ScrollViewer MaxHeight="150" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ExclusionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveExclusionClick"
                                                        ToolTip="Retirer de la liste">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="Dossiers de jeux personnalisés" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="Ces dossiers seront scannés à la prochaine recherche de jeux." />

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnAddFolderClick"
                                ToolTip="Choisir un dossier de jeux non détecté automatiquement">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Ajouter un dossier" />
                            </StackPanel>
                        </Button>

                        <ScrollViewer MaxHeight="150" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FolderList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                           VerticalAlignment="Center" ToolTip="{Binding}" />
                                                <Button Style="{StaticResource GhostButton}" Padding="6,0"
                                                        Margin="8,0,0,0" Tag="{Binding}"
                                                        Click="OnRemoveFolderClick"
                                                        ToolTip="Retirer ce dossier de la liste">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Overlay &amp; Monitoring" Style="{StaticResource H3}" />

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="OverlayEnabledToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Affiche une surimpression en jeu : FPS, températures, charges" />
                            <TextBlock Text="Overlay activé" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowFpsToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher le nombre d'images par seconde" />
                            <TextBlock Text="FPS" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowFrameTimeToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher le temps par image : utile pour détecter les saccades" />
                            <TextBlock Text="Temps par image" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowCpuToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher la charge du processeur" />
                            <TextBlock Text="CPU" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowGpuToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher la charge de la carte graphique" />
                            <TextBlock Text="GPU" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowRamToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher la mémoire vive utilisée" />
                            <TextBlock Text="RAM" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ToggleRow}">
                            <ToggleButton x:Name="ShowTempToggle" Style="{StaticResource Toggle}"
                                          Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                                          ToolTip="Afficher les températures CPU et GPU si les capteurs sont disponibles" />
                            <TextBlock Text="Températures" Style="{StaticResource Body}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacité de l'overlay" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OpacityLabel" Grid.Column="1" Text="85 %"
                                       Style="{StaticResource Caption}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource Slider}" Minimum="30" Maximum="100"
                                Value="85" Margin="0,6,0,0" ValueChanged="OnOpacityChanged"
                                ToolTip="Transparence de l'overlay en jeu : 30 % très transparent, 100 % opaque" />

                        <Separator Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                        <CheckBox x:Name="RecordSessionsCheck" Content="Enregistrer les sessions"
                                  Checked="OnRecordSessionsChanged" Unchecked="OnRecordSessionsChanged"
                                  ToolTip="Conserve les mesures de chaque session de jeu pour les comparer" />

                        <TextBlock Text="Rétention de l'historique" Style="{StaticResource Label}" Margin="0,14,0,0" />
                        <ComboBox x:Name="RetentionCombo" Margin="0,6,0,0" SelectionChanged="OnRetentionChanged"
                                  ToolTip="Durée pendant laquelle les sessions passées sont conservées" />

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnPruneHistoryClick"
                                ToolTip="Supprime immédiatement les sessions plus anciennes que la rétention choisie">
                            <TextBlock Text="Appliquer maintenant" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Sauvegardes &amp; journaux" Style="{StaticResource H3}" />

                        <TextBlock Text="Emplacement des sauvegardes" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource SectionNote}"
                                   Text="Vide = dossier par défaut de GameBoost. Les profils appliqués y déposent une copie des fichiers modifiés." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupBox" Grid.Column="0" TextChanged="OnBackupLocationChanged"
                                     ToolTip="Dossier dans lequel GameBoost copie les fichiers avant de les modifier" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnBrowseBackupClick"
                                    ToolTip="Choisir un autre dossier de sauvegarde">
                                <TextBlock Text="Parcourir…" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="OnOpenBackupClick"
                                    ToolTip="Ouvrir le dossier des sauvegardes dans l'explorateur">
                                <TextBlock Text="Ouvrir le dossier" />
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Click="OnOpenLogsClick"
                                    ToolTip="Ouvrir le dossier contenant les fichiers journaux">
                                <TextBlock Text="Ouvrir le dossier des journaux" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="OnShowLogsClick"
                                    ToolTip="Affiche les 200 dernières lignes écrites aujourd'hui">
                                <TextBlock Text="Afficher les 200 dernières lignes de journal" />
                            </Button>
                        </StackPanel>

                        <Border x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource CardFlat}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Journal du jour" Style="{StaticResource Label}" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Click="OnCopyLogsClick"
                                            ToolTip="Copier tout l'affichage dans le presse-papiers">
                                        <TextBlock Text="Copier" />
                                    </Button>
                                </Grid>
                                <ScrollViewer MaxHeight="280" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnTrimLogsClick"
                                ToolTip="Supprime les journaux plus anciens que la durée de conservation définie">
                            <TextBlock Text="Nettoyer les journaux anciens" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="À propos" Style="{StaticResource H3}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Version" Style="{StaticResource Label}" />
                            <TextBlock x:Name="VersionText" Text="1.0.0" Style="{StaticResource Body}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,10,0,0"
                                   Text="Vos données restent sur ce PC — aucun compte, aucun envoi." />
                        <Border Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Body}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="GameBoost ne promet aucun gain de FPS précis : les résultats dépendent de votre configuration, de vos pilotes et des jeux joués." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
