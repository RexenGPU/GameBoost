<UserControl x:Class="GameBoost.App.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls"
             xmlns:loc="clr-namespace:GameBoost.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Text Hist_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Hist_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Click="OnRefreshClick"
                        ToolTip="{loc:Text Hist_RefreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Hist_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="OnExportSelectionClick" Margin="10,0,0,0"
                        ToolTip="{loc:Text Hist_ExportSelectionTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Hist_ExportSelection}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="OnClearClick" Margin="10,0,0,0"
                        ToolTip="{loc:Text Hist_ClearTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Hist_Clear}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="EmptyPanel" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{loc:Text Hist_EmptyTitle}" Style="{StaticResource H2}" />
                <TextBlock Text="{loc:Text Hist_EmptyNote}"
                           Style="{StaticResource BodyMuted}" Margin="0,8,0,0" />
                <Button Style="{StaticResource AccentButton}" Click="OnHowToRecordClick" Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        ToolTip="{loc:Text Hist_HowToRecordTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text Hist_HowToRecord}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text Hist_SessionsTitle}" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource CardFlat}" CornerRadius="999" Padding="9,3" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{loc:Text Hist_SelectionTip}">
                            <TextBlock x:Name="SelectionCountText" Text="{loc:Text Hist_SelectionNoneSummary}"
                                       Style="{StaticResource Caption}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Text Hist_SortedNote}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="{loc:Text Hist_AvgFps}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" Width="104" />
                    <TextBlock Grid.Column="3" Text="{loc:Text Hist_LowMinMax}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" Width="136" />
                    <TextBlock Grid.Column="4" Text="{loc:Text Hist_GpuTempUsage}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" Width="124" />
                    <TextBlock Grid.Column="5" Text="{loc:Text Hist_Duration}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" Width="76" Margin="12,0,0,0" />
                </Grid>

                <ScrollViewer x:Name="SessionsScroll" Margin="0,8,0,0" MaxHeight="400"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              ToolTip="{loc:Text Hist_RowClickTip}">
                    <StackPanel x:Name="SessionsPanel" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text Hist_CompareTitle}" Style="{StaticResource H2}" />
                        <TextBlock Text="{loc:Text Hist_CompareLegendNote}" Style="{StaticResource Caption}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CompareButton" Style="{StaticResource AccentButton}"
                            Click="OnCompareClick" IsEnabled="False" HorizontalAlignment="Right"
                            ToolTip="{loc:Text Hist_CompareTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hist_Compare}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="{loc:Text Hist_CompareNote}"
                           Style="{StaticResource Caption}" Margin="0,8,0,0" />

                <StackPanel x:Name="ComparisonPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid x:Name="ComparisonTable" />
                    <controls:LineChart x:Name="CompareChart" Height="170" Margin="0,12,0,0" MaxPoints="300"
                                        ShowGrid="True" Visibility="Collapsed"
                                        ToolTip="{loc:Text Hist_CompareChartTip}" />
                    <TextBlock x:Name="CompareChartHint" Text="" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DetailPanel" Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="{loc:Text Hist_SessionTitle}" Style="{StaticResource H2}" />
                        <TextBlock x:Name="DetailMeta" Text="" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Click="OnExportDetailClick"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="{loc:Text Hist_ExportDetailTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hist_ExportDetail}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <UniformGrid Columns="4" Margin="0,14,0,0">
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_AvgFps}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailFps" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_OnePercentLow}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailLow" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_MinMax}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailMinMax" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:Text Hist_Duration}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailDuration" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_GpuDetail}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailGpu" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_CpuDetail}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailCpu" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="{loc:Text Hist_RamPeak}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailRam" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:Text Hist_ProfileUsed}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailProfile" Text="—" Style="{StaticResource Mono}" FontSize="15"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{loc:Text Hist_FrameTimeTitle}" Style="{StaticResource Label}" />
                    <controls:LineChart x:Name="DetailFrameTimeChart" Height="150" Margin="0,8,0,0" MaxPoints="300"
                                        ShowGrid="True" Visibility="Collapsed"
                                        ToolTip="{loc:Text Hist_FrameTimeChartTip}" />
                    <TextBlock x:Name="DetailFrameTimeHint" Text="{loc:Text Hist_FrameTimeHint}"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{loc:Text Hist_Optimizations}" Style="{StaticResource Label}" />
                        <StackPanel x:Name="DetailOptimizationsPanel" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{loc:Text Hist_Notes}" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailNotes" Text="—" Style="{StaticResource BodyMuted}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
