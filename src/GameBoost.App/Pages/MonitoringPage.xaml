<UserControl x:Class="GameBoost.App.Pages.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls"
             xmlns:loc="clr-namespace:GameBoost.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Text Mon_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Text Mon_Subtitle}"
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource CardFlat}" Padding="12,8" CornerRadius="999"
                        ToolTip="{loc:Text Mon_MonitorBadgeTip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorDot" Width="9" Height="9" Fill="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="MonitorStateText" Text="{loc:Text Mon_MonitorInactive}"
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="MonitorToggleButton" Style="{StaticResource AccentButton}"
                        Click="OnMonitorToggleClick" Margin="10,0,0,0"
                        ToolTip="{loc:Text Mon_MonitorToggleTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="MonitorToggleLabel" Text="{loc:Text Mon_Start}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Text Mon_TrackingTitle}" Style="{StaticResource H2}" />
                <TextBlock Text="{loc:Text Mon_TrackingNote}"
                           Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GameCombo" Style="{StaticResource Combo}" MinWidth="240"
                              DisplayMemberPath="Name"
                              ToolTip="{loc:Text Mon_GameComboTip}" />
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Click="OnTrackClick"
                            Margin="10,0,0,0"
                            ToolTip="{loc:Text Mon_TrackTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Mon_TrackButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="OnUntrackClick"
                            Margin="10,0,0,0"
                            ToolTip="{loc:Text Mon_UntrackTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Mon_UntrackButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="OnOpenGamesClick"
                            Margin="10,0,0,0"
                            ToolTip="{loc:Text Mon_OpenGamesTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Mon_OpenGamesButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="TrackedText" Text="{loc:Text Mon_TrackedNone}" Style="{StaticResource Mono}"
                           Margin="0,11,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Text Mon_FpsTitle}" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="FpsValueText" Text="—" Style="{StaticResource ValueBig}" FontSize="48" />
                        <TextBlock Text="FPS" Style="{StaticResource BodyMuted}" FontSize="18" Margin="10,26,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="FpsSourceText" Text="{loc:Text Mon_FpsNoMeasure}"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="{loc:Text Mon_FrameTimeLabel}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="FrameTimeValueText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="{loc:Text Mon_OnePercentLow}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OnePercentText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{loc:Text Mon_Median}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MedianFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="{loc:Text Mon_Minimum}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MinFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="{loc:Text Mon_Maximum}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MaxFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Text Mon_Samples}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="SampleCountText" Text="0" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnResetFpsClick"
                            ToolTip="{loc:Text Mon_ResetStatsTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Mon_ResetStats}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="{loc:Text Mon_FrameTimeChartTitle}" Style="{StaticResource H3}" />
                    <TextBlock Text="{loc:Text Mon_FrameTimeChartNote}"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <controls:LineChart x:Name="FrameTimeChart" Height="170" Margin="0,10,0,0"
                                        MaxPoints="300" ShowGrid="True"
                                        ToolTip="{loc:Text Mon_ChartTip}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="FPS" Style="{StaticResource H3}" />
                    <TextBlock Text="{loc:Text Mon_FpsChartNote}"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <controls:LineChart x:Name="FpsChart" Height="170" Margin="0,10,0,0"
                                        MaxPoints="300" ShowGrid="True"
                                        ToolTip="{loc:Text Mon_ChartTip}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <UniformGrid Columns="3">
                <controls:StatCard x:Name="CardCpu" Title="{loc:Text Mon_CpuUsage}" Icon="&#xE9F0;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Mon_CpuUsageTip}" />
                <controls:StatCard x:Name="CardGpu" Title="{loc:Text Mon_GpuUsage}" Icon="&#xE7F4;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="{loc:Text Mon_GpuUsageTip}" />
                <controls:StatCard x:Name="CardRam" Title="{loc:Text Mon_RamUsage}" Icon="&#xE7C5;" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="{loc:Text Mon_RamUsageTip}" />
                <controls:StatCard x:Name="CardCpuTemp" Title="{loc:Text Mon_CpuTemp}" Icon="&#xE706;" Unit="°C"
                                   Value="—" Margin="0,0,10,0"
                                   ToolTip="{loc:Text Mon_CpuTempTip}" />
                <controls:StatCard x:Name="CardGpuTemp" Title="{loc:Text Mon_GpuTemp}" Icon="&#xE7C3;" Unit="°C"
                                   Value="—" Margin="0,0,10,0"
                                   ToolTip="{loc:Text Mon_GpuTempTip}" />
                <controls:StatCard x:Name="CardVram" Title="{loc:Text Mon_VramUsage}" Icon="&#xE77B;" Value="—"
                                   Margin="0,0,0,0"
                                   ToolTip="{loc:Text Mon_VramUsageTip}" />
            </UniformGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,10,7,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{loc:Text Mon_SessionTitle}" Style="{StaticResource H2}" />
                    <TextBlock Text="{loc:Text Mon_SessionNote}"
                               Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                    <Border x:Name="SessionStateBadge" Style="{StaticResource CardFlat}" CornerRadius="9"
                            Padding="11,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SessionStateText" Text="{loc:Text Mon_SessionNone}"
                                       Style="{StaticResource Body}" />
                            <TextBlock x:Name="SessionGameText" Text="{loc:Text Mon_SessionGameNone}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StartSessionButton" Style="{StaticResource AccentButton}"
                                Click="OnStartSessionClick"
                                ToolTip="{loc:Text Mon_StartRecordingTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Mon_StartRecording}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopSessionButton" Style="{StaticResource SecondaryButton}"
                                Click="OnStopSessionClick" Margin="10,0,0,0" IsEnabled="False"
                                ToolTip="{loc:Text Mon_StopRecordingTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Mon_StopRecording}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Click="OnOpenHistoryClick" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            ToolTip="{loc:Text Mon_OpenHistoryTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Text Mon_OpenHistory}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,10,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Text Mon_OverlayTitle}" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource CardFlat}" CornerRadius="999" Padding="10,4"
                                HorizontalAlignment="Right"
                                ToolTip="{loc:Text Mon_OverlayStateTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OverlayDot" Width="8" Height="8"
                                         Fill="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayBadgeText" Text="{loc:Text Mon_OverlayInactive}"
                                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{loc:Text Mon_OverlayNote}"
                               Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{loc:Text Mon_ShowOverlayInGame}"
                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="OverlayEnabledToggle" Style="{StaticResource Toggle}"
                                      HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                      Unchecked="OnOverlayOptionChanged"
                                      ToolTip="{loc:Text Mon_OverlayEnabledTip}" />
                    </Grid>

                    <TextBlock Text="{loc:Text Mon_ContentLabel}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="FPS" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayFpsToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayFpsTip}" />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="{loc:Text Mon_LblFrametime}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayFrameTimeToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayFrameTimeTip}" />
                        </Grid>
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="CPU" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayCpuToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayCpuTip}" />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="GPU" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayGpuToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayGpuTip}" />
                        </Grid>
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="RAM" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayRamToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayRamTip}" />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="{loc:Text Mon_Temperatures}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayTempToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="{loc:Text Mon_OverlayTempTip}" />
                        </Grid>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{loc:Text Mon_OpacityLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityValueText" Text="85 %" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource Slider}" Minimum="30" Maximum="100"
                            Value="85" Margin="0,4,0,0" ValueChanged="OnOpacityChanged"
                            ToolTip="{loc:Text Mon_OpacityTip}" />

                    <TextBlock Text="{loc:Text Mon_PositionLabel}" Style="{StaticResource Label}" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="CornerTopLeft" Style="{StaticResource Chip}" GroupName="overlayCorner"
                                     Content="{loc:Text Mon_CornerTopLeft}" Tag="tl" Checked="OnCornerChecked"
                                     ToolTip="{loc:Text Mon_CornerTopLeftTip}" />
                        <RadioButton x:Name="CornerTopRight" Style="{StaticResource Chip}" GroupName="overlayCorner"
                                     Content="{loc:Text Mon_CornerTopRight}" Tag="tr" Checked="OnCornerChecked" Margin="7,0,0,0"
                                     ToolTip="{loc:Text Mon_CornerTopRightTip}" />
                        <RadioButton x:Name="CornerBottomLeft" Style="{StaticResource Chip}"
                                     GroupName="overlayCorner" Content="{loc:Text Mon_CornerBottomLeft}" Tag="bl" Checked="OnCornerChecked"
                                     Margin="7,0,0,0" ToolTip="{loc:Text Mon_CornerBottomLeftTip}" />
                        <RadioButton x:Name="CornerBottomRight" Style="{StaticResource Chip}"
                                     GroupName="overlayCorner" Content="{loc:Text Mon_CornerBottomRight}" Tag="br" Checked="OnCornerChecked"
                                     Margin="7,0,0,0" ToolTip="{loc:Text Mon_CornerBottomRightTip}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Click="OnPreviewOverlayClick"
                                ToolTip="{loc:Text Mon_PreviewTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Mon_Preview}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="OnOpenGamesClick" Margin="10,0,0,0"
                                ToolTip="{loc:Text Mon_OpenLibraryTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Mon_OpenGamesButton}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{loc:Text Mon_OverlaySaveNote}"
                               Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
