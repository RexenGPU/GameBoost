<UserControl x:Class="GameBoost.App.Pages.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Monitoring" Style="{StaticResource H1}" />
                <TextBlock Text="Mesures réelles de votre PC : FPS, frametime, températures et utilisation pendant le jeu."
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource CardFlat}" Padding="12,8" CornerRadius="999"
                        ToolTip="Le moniteur échantillonne le PC toutes les secondes tant qu'il est actif.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorDot" Width="9" Height="9" Fill="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="MonitorStateText" Text="Monitoring inactif"
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="MonitorToggleButton" Style="{StaticResource AccentButton}"
                        Click="OnMonitorToggleClick" Margin="10,0,0,0"
                        ToolTip="Démarre ou arrête la collecte des mesures (intervalle d'une seconde).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="MonitorToggleLabel" Text="Démarrer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Suivi du jeu" Style="{StaticResource H2}" />
                <TextBlock Text="Choisissez un jeu pour mesurer ses FPS et sa frametime. Le suivi ne produit des images que si le jeu est en cours d'exécution."
                           Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GameCombo" Style="{StaticResource Combo}" MinWidth="240"
                              DisplayMemberPath="Name"
                              ToolTip="Jeux détectés sur ce PC (page Jeux pour en ajouter d'autres)." />
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Click="OnTrackClick"
                            Margin="10,0,0,0"
                            ToolTip="Recherche le processus du jeu sélectionné et mesure ses images par seconde.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Suivre ce jeu" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="OnUntrackClick"
                            Margin="10,0,0,0"
                            ToolTip="Arrête la mesure des images du jeu suivi. Les statistiques déjà calculées sont conservées.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Arrêter le suivi" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="OnOpenGamesClick"
                            Margin="10,0,0,0"
                            ToolTip="Ouvre la bibliothèque de jeux pour ajouter ou modifier un jeu.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ouvrir la page Jeux" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="TrackedText" Text="Suivi : aucun processus" Style="{StaticResource Mono}"
                           Margin="0,11,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Images par seconde" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="FpsValueText" Text="—" Style="{StaticResource ValueBig}" FontSize="48" />
                        <TextBlock Text="FPS" Style="{StaticResource BodyMuted}" FontSize="18" Margin="10,26,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="FpsSourceText" Text="Aucune mesure d'image disponible pour l'instant."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Frametime actuel" Style="{StaticResource Label}" />
                            <TextBlock x:Name="FrameTimeValueText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="1 % low" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OnePercentText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Médiane" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MedianFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Minimum" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MinFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Maximum" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MaxFpsText" Text="—" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Échantillons" Style="{StaticResource Label}" />
                            <TextBlock x:Name="SampleCountText" Text="0" Style="{StaticResource Mono}"
                                       FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Click="OnResetFpsClick"
                            ToolTip="Efface les statistiques d'images accumulées (moyenne, minimum, 1 % low) et repart à zéro.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Réinitialiser les statistiques" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Frametime (ms)" Style="{StaticResource H3}" />
                    <TextBlock Text="Temps écoulé entre deux images : plus il est bas et stable, plus le jeu est fluide."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <controls:LineChart x:Name="FrameTimeChart" Height="170" Margin="0,10,0,0"
                                        MaxPoints="300" ShowGrid="True"
                                        ToolTip="Mesures relevées chaque seconde, 300 derniers points." />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="FPS" Style="{StaticResource H3}" />
                    <TextBlock Text="Images par seconde mesurées sur le jeu suivi. Aucune valeur n'est estimée."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <controls:LineChart x:Name="FpsChart" Height="170" Margin="0,10,0,0"
                                        MaxPoints="300" ShowGrid="True"
                                        ToolTip="Mesures relevées chaque seconde, 300 derniers points." />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <UniformGrid Columns="3">
                <controls:StatCard x:Name="CardCpu" Title="Utilisation CPU" Icon="&#xE9F0;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="Part du processeur utilisée, relevée chaque seconde." />
                <controls:StatCard x:Name="CardGpu" Title="Utilisation GPU" Icon="&#xE7F4;" Unit="%"
                                   Value="—" Margin="0,0,10,10"
                                   ToolTip="Part de la carte graphique utilisée, relevée chaque seconde." />
                <controls:StatCard x:Name="CardRam" Title="RAM utilisée" Icon="&#xE7C5;" Value="—"
                                   Margin="0,0,10,10"
                                   ToolTip="Mémoire vive occupée par l'ensemble des applications en cours." />
                <controls:StatCard x:Name="CardCpuTemp" Title="Température CPU" Icon="&#xE706;" Unit="°C"
                                   Value="—" Margin="0,0,10,0"
                                   ToolTip="Température du processeur : indisponible si aucun capteur n'est lisible." />
                <controls:StatCard x:Name="CardGpuTemp" Title="Température GPU" Icon="&#xE7C3;" Unit="°C"
                                   Value="—" Margin="0,0,10,0"
                                   ToolTip="Température de la carte graphique : indisponible si aucun capteur n'est lisible." />
                <controls:StatCard x:Name="CardVram" Title="VRAM utilisée" Icon="&#xE77B;" Value="—"
                                   Margin="0,0,0,0"
                                   ToolTip="Mémoire vidéo dédiée utilisée par la carte graphique." />
            </UniformGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,10,7,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Enregistrement de session" Style="{StaticResource H2}" />
                    <TextBlock Text="La session capture FPS, températures et utilisation pour les comparer ultérieurement dans l'historique."
                               Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />
                    <Border x:Name="SessionStateBadge" Style="{StaticResource CardFlat}" CornerRadius="9"
                            Padding="11,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SessionStateText" Text="Aucune session en cours."
                                       Style="{StaticResource Body}" />
                            <TextBlock x:Name="SessionGameText" Text="Jeu : aucun sélectionné"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StartSessionButton" Style="{StaticResource AccentButton}"
                                Click="OnStartSessionClick"
                                ToolTip="Démarre l'enregistrement des mesures pour le jeu sélectionné ou suivi.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Démarrer l'enregistrement" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopSessionButton" Style="{StaticResource SecondaryButton}"
                                Click="OnStopSessionClick" Margin="10,0,0,0" IsEnabled="False"
                                ToolTip="Arrête l'enregistrement, calcule les statistiques et enregistre la session localement.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Arrêter et sauvegarder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Click="OnOpenHistoryClick" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            ToolTip="Ouvre la page Historique pour consulter et comparer les sessions enregistrées.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Voir l'historique des sessions" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,10,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Overlay" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource CardFlat}" CornerRadius="999" Padding="10,4"
                                HorizontalAlignment="Right"
                                ToolTip="État de l'overlay GameBoost pendant le jeu.">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OverlayDot" Width="8" Height="8"
                                         Fill="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayBadgeText" Text="Overlay : inactif"
                                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Affichez vos mesures par-dessus le jeu, sans quitter la fenêtre de jeu."
                               Style="{StaticResource BodyMuted}" Margin="0,5,0,0" />

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Afficher l'overlay pendant le jeu"
                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="OverlayEnabledToggle" Style="{StaticResource Toggle}"
                                      HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                      Unchecked="OnOverlayOptionChanged"
                                      ToolTip="Active la recherche automatique d'un jeu lancé et l'affichage de l'overlay." />
                    </Grid>

                    <TextBlock Text="Contenu affiché" Style="{StaticResource Label}" Margin="0,12,0,0" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="FPS" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayFpsToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche les images par seconde mesurées et le 1 % low." />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="Frametime" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayFrameTimeToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche le temps entre deux images en millisecondes." />
                        </Grid>
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="CPU" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayCpuToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche l'utilisation du processeur." />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="GPU" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayGpuToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche l'utilisation de la carte graphique." />
                        </Grid>
                        <Grid Margin="0,0,8,7">
                            <TextBlock Text="RAM" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayRamToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche la mémoire vive utilisée." />
                        </Grid>
                        <Grid Margin="8,0,0,7">
                            <TextBlock Text="Températures" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="OverlayTempToggle" Style="{StaticResource Toggle}"
                                          HorizontalAlignment="Right" Checked="OnOverlayOptionChanged"
                                          Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Affiche les températures CPU et GPU quand elles sont mesurables." />
                        </Grid>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Opacité" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityValueText" Text="85 %" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource Slider}" Minimum="30" Maximum="100"
                            Value="85" Margin="0,4,0,0" ValueChanged="OnOpacityChanged"
                            ToolTip="Transparence de la fenêtre d'overlay : 30 % = très translucide, 100 % = opaque." />

                    <TextBlock Text="Position à l'écran" Style="{StaticResource Label}" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="CornerTopLeft" Style="{StaticResource Chip}" GroupName="overlayCorner"
                                     Content="Haut gauche" Tag="tl" Checked="OnCornerChecked"
                                     ToolTip="En haut à gauche de l'écran." />
                        <RadioButton x:Name="CornerTopRight" Style="{StaticResource Chip}" GroupName="overlayCorner"
                                     Content="Haut droite" Tag="tr" Checked="OnCornerChecked" Margin="7,0,0,0"
                                     ToolTip="En haut à droite de l'écran." />
                        <RadioButton x:Name="CornerBottomLeft" Style="{StaticResource Chip}"
                                     GroupName="overlayCorner" Content="Bas gauche" Tag="bl" Checked="OnCornerChecked"
                                     Margin="7,0,0,0" ToolTip="En bas à gauche de l'écran." />
                        <RadioButton x:Name="CornerBottomRight" Style="{StaticResource Chip}"
                                     GroupName="overlayCorner" Content="Bas droite" Tag="br" Checked="OnCornerChecked"
                                     Margin="7,0,0,0" ToolTip="En bas à droite de l'écran." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Click="OnPreviewOverlayClick"
                                ToolTip="Affiche ou masque immédiatement l'overlay avec les réglages du jeu sélectionné.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Prévisualiser l'overlay" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="OnOpenGamesClick" Margin="10,0,0,0"
                                ToolTip="Ouvre la bibliothèque de jeux.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Ouvrir la page Jeux" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Les réglages d'overlay sont enregistrés pour le jeu sélectionné, ou comme valeur par défaut si aucun jeu n'est choisi."
                               Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
