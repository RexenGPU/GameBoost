<UserControl x:Class="GameBoost.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProfileCardBorder" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="300" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveChip" TargetType="Border" BasedOn="{StaticResource CardFlat}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource GoodBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BulletDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Profils" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                           Text="Quatre profils par jeu : qualité maximale, équilibré, performance et personnalisé. Ils sont enregistrés localement, dans la base de GameBoost." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="GameCombo" Width="260" Margin="0,0,10,0"
                          DisplayMemberPath="Name" SelectionChanged="OnGameChanged"
                          ToolTip="Jeu concerné par les profils affichés" />
                <Button Style="{StaticResource SecondaryButton}" Click="OnRefreshGamesClick"
                        ToolTip="Recharger la liste des jeux installés">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="NoGamesText" Grid.Row="1" Style="{StaticResource BodyMuted}"
                   Margin="0,16,0,0" Visibility="Collapsed"
                   Text="Aucun jeu dans la bibliothèque. Ouvrez la page « Jeux » pour lancer une analyse, puis revenez ici." />

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MaxHeight="470" Focusable="False">
                <ItemsControl x:Name="CardsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProfileCardBorder}"
                                    MouseLeftButtonDown="OnCardClick" Tag="{Binding}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Profile.Name}" Style="{StaticResource H3}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PresetLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ActiveChip}"
                                                VerticalAlignment="Top"
                                                ToolTip="Ce profil est celui utilisé pour le boost">
                                            <TextBlock Text="Actif" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource GoodBrush}" />
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Bullets}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Style="{StaticResource BulletDot}" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding UpdatedLabel}" Style="{StaticResource Label}"
                                               Margin="0,10,0,0" />

                                    <Separator Margin="0,10,0,8" Background="{DynamicResource BorderBrush}" />

                                    <RadioButton Content="Profil actif" GroupName="activeProfile"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                 Checked="OnActiveChecked" Tag="{Binding}"
                                                 ToolTip="Ce profil sera appliqué lors d'un boost" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Padding="12,7"
                                                Click="OnEditClick" Tag="{Binding}"
                                                ToolTip="Modifier les réglages de ce profil">
                                            <TextBlock Text="Éditer" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="8,0,0,0"
                                                Click="OnDuplicateClick" Tag="{Binding}"
                                                ToolTip="Créer une copie modifiable de ce profil">
                                            <TextBlock Text="Dupliquer" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="NoProfilesPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Margin="0,30,0,0" MaxWidth="460">
                <TextBlock Text="Aucun profil pour ce jeu" Style="{StaticResource H2}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource BodyMuted}" Margin="0,8,0,0" TextAlignment="Center"
                           Text="Créez les quatre profils par défaut : leurs réglages sont générés à partir de ce que GameBoost sait de votre carte graphique, puis vous pourrez les ajuster." />
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="OnCreatePresetsClick"
                        ToolTip="Créer Qualité maximale, Équilibré, Performance et Personnalisé">
                    <TextBlock Text="Créer les 4 profils par défaut" />
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="EditorPanel" Grid.Row="3" Style="{StaticResource Card}" Margin="0,4,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="EditorTitle" Style="{StaticResource H2}" Text="Éditeur de profil" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnCloseEditorClick"
                            ToolTip="Fermer l'éditeur">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </Grid>
                <TextBlock x:Name="EditorSubTitle" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Résolution" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ResolutionCombo" Margin="0,6,0,12" />
                        <TextBlock Text="Textures" Style="{StaticResource Label}" />
                        <ComboBox x:Name="TextureCombo" Margin="0,6,0,12" />
                        <TextBlock Text="Ombres" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ShadowCombo" Margin="0,6,0,12" />
                        <TextBlock Text="Éclairage" Style="{StaticResource Label}" />
                        <ComboBox x:Name="LightingCombo" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="RtToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Reflets et ombres plus réalistes, mais très coûteux en FPS" />
                                <TextBlock Text="Ray tracing" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="DlssToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Montée en résolution Nvidia : plus de FPS à qualité égale" />
                                <TextBlock Text="DLSS" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="FsrToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Montée en résolution AMD : plus de FPS" />
                                <TextBlock Text="FSR" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="XessToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Montée en résolution Intel : plus de FPS" />
                                <TextBlock Text="XeSS" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="VSyncToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Evite les déchirures d'écran, peut ajouter de la latence" />
                                <TextBlock Text="V-Sync" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,11">
                                <ToggleButton x:Name="FullscreenToggle" Style="{StaticResource Toggle}"
                                              Checked="OnEditorChanged" Unchecked="OnEditorChanged"
                                              ToolTip="Plein écran plutôt que fenêtré : souvent plus rapide" />
                                <TextBlock Text="Plein écran" Style="{StaticResource Body}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Limite FPS" Style="{StaticResource Label}" Margin="0,6,0,0" />
                        <TextBox x:Name="FpsBox" Margin="0,6,0,12"
                                 ToolTip="Laissez vide pour ne pas limiter les images par seconde" />

                        <TextBlock Text="Interrupteurs à trois états" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Éteint = désactivé. Un profil d'origine peut laisser un réglage « non défini » : il apparaît éteint tant que vous ne le touchez pas." />
                    </StackPanel>
                </Grid>

                <Border x:Name="CapabilityBanner" Visibility="Collapsed" Margin="0,16,0,0"
                        Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" />
                        <TextBlock x:Name="CapabilityText" Style="{StaticResource Body}" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Notes" Style="{StaticResource Label}" />
                        <TextBox x:Name="NotesBox" Margin="0,6,0,0" Height="72" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="Commentaires libres conservés avec ce profil" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}" Click="OnResetEditorClick"
                                ToolTip="Annuler les modifications non enregistrées">
                            <TextBlock Text="Réinitialiser" />
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="OnSaveProfileClick"
                                ToolTip="Enregistrer ce profil dans la base locale">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Enregistrer" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ApplyPanel" Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Application au jeu" Style="{StaticResource H3}" />
                <TextBlock x:Name="ApplySupportText" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
                <TextBlock x:Name="ApplySupportDetail" Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                           Visibility="Collapsed"
                           Text="Votre profil reste enregistré comme référence. GameBoost n'édite que les fichiers de configuration qu'il connaît (moteurs Unreal Engine, Unity et fichiers INI/CFG génériques)." />
                <TextBlock x:Name="ElevationNote" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="Collapsed"
                           Text="GameBoost tourne sans droits administrateur : certains fichiers de configuration protégés ne seront pas modifiables. Relancez GameBoost en administrateur depuis la page Paramètres." />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="DryRunButton" Style="{StaticResource SecondaryButton}"
                            Click="OnDryRunClick"
                            ToolTip="Simulation : liste les réglages qui seraient écrits, sans rien modifier">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Vérifier ce qui serait changé" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                            Click="OnApplyClick"
                            ToolTip="Écrire les réglages dans les fichiers de configuration du jeu, après confirmation">
                        <TextBlock Text="Appliquer" />
                    </Button>
                    <Button x:Name="RevertButton" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="OnRevertClick"
                            ToolTip="Remettre les fichiers de configuration dans l'état d'avant l'application">
                        <TextBlock Text="Restaurer la sauvegarde" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="ApplyMessage" Style="{StaticResource Body}" Margin="0,12,0,0"
                           Visibility="Collapsed" />
                <TextBlock x:Name="BackupPathText" Style="{StaticResource Mono}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <ScrollViewer MaxHeight="180" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                              x:Name="ChangedKeysScroll">
                    <ItemsControl x:Name="ChangedKeysList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Style="{StaticResource BulletDot}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
