<UserControl x:Class="GameBoost.App.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameBoost.App.Controls">
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" Grid.Column="0" FontFamily="{StaticResource IconFont}"
                           FontSize="14" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:StatCard}}"
                           Style="{StaticResource Label}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=local:StatCard}}"
                           Style="{StaticResource ValueBig}" />
                <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=local:StatCard}}"
                           Style="{StaticResource BodyMuted}" Margin="6,7,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="0,4,0,0"
                       Text="{Binding SubText, RelativeSource={RelativeSource AncestorType=local:StatCard}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SubText, RelativeSource={RelativeSource AncestorType=local:StatCard}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ProgressBar x:Name="Bar" Grid.Row="3" Margin="0,10,0,0" Height="5"
                         Style="{StaticResource SlimProgress}" Visibility="Collapsed"
                         Minimum="0" Maximum="100" />
        </Grid>
    </Border>
</UserControl>
