<UserControl x:Class="GameBoost.App.Controls.HealthBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameBoost.App.Controls">
    <StackPanel Orientation="Horizontal" Background="Transparent"
                ToolTipService.InitialShowDelay="400">
        <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center" />
        <TextBlock x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Caption}" FontSize="12" />
    </StackPanel>
</UserControl>
