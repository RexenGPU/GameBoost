<Window x:Class="GameBoost.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBoost"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Left="-3000"
        Top="-3000">
    <Border x:Name="Card"
            CornerRadius="10"
            Background="#CC10151C"
            BorderBrush="#4022C55E"
            BorderThickness="1"
            Padding="14,11"
            IsHitTestVisible="False"
            ToolTip="Overlay GameBoost : mesures réelles issues du monitoring, aucune valeur estimée.">
        <StackPanel>
            <StackPanel x:Name="FpsPanel">
                <TextBlock x:Name="FpsText"
                           Text="— FPS"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#22C55E" />
                <TextBlock x:Name="LowText"
                           Text=""
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#93A1B0"
                           Margin="0,1,0,0" />
            </StackPanel>
            <TextBlock x:Name="FrameTimeText"
                       Text="— ms"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#E7EEF5"
                       Margin="0,5,0,0" />
            <TextBlock x:Name="CpuText"
                       Text="CPU — %"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#E7EEF5"
                       Margin="0,3,0,0" />
            <TextBlock x:Name="GpuText"
                       Text="GPU — %"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#E7EEF5"
                       Margin="0,3,0,0" />
            <TextBlock x:Name="RamText"
                       Text="RAM —"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#E7EEF5"
                       Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</Window>
