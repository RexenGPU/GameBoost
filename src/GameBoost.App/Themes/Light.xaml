<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#F2F5F8</Color>
    <Color x:Key="BgSideColor">#FFFFFF</Color>
    <Color x:Key="BgTitleColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardAltColor">#F8FAFC</Color>
    <Color x:Key="CardHoverColor">#F1F5F9</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#5B6B7F</Color>
    <Color x:Key="TextFaintColor">#94A3B8</Color>
    <Color x:Key="AccentColor">#16A34A</Color>
    <Color x:Key="AccentHoverColor">#15803D</Color>
    <Color x:Key="AccentDarkColor">#15803D</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerBgColor">#FEE2E2</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="WarnBgColor">#FEF3C7</Color>
    <Color x:Key="GoodColor">#059669</Color>
    <Color x:Key="GoodBgColor">#D1FAE5</Color>
    <Color x:Key="InfoColor">#0369A1</Color>
    <Color x:Key="InfoBgBrushTmp">#E0F2FE</Color>
    <Color x:Key="InfoBgColor">#E0F2FE</Color>
    <Color x:Key="ScrollThumbColor">#C3CDD9</Color>
    <Color x:Key="OverlayBgColor">#F2FFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgSideBrush" Color="{StaticResource BgSideColor}" />
    <SolidColorBrush x:Key="BgTitleBrush" Color="{StaticResource BgTitleColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardAltBrush" Color="{StaticResource CardAltColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="GoodBgBrush" Color="{StaticResource GoodBgColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="OverlayBgBrush" Color="{StaticResource OverlayBgColor}" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000" />

</ResourceDictionary>
