<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#0B0F14</Color>
    <Color x:Key="BgSideColor">#090D12</Color>
    <Color x:Key="BgTitleColor">#090D12</Color>
    <Color x:Key="CardColor">#121A23</Color>
    <Color x:Key="CardAltColor">#0E151D</Color>
    <Color x:Key="CardHoverColor">#16212C</Color>
    <Color x:Key="BorderColor">#1E2833</Color>
    <Color x:Key="BorderStrongColor">#2E3D4E</Color>
    <Color x:Key="TextColor">#E7EEF5</Color>
    <Color x:Key="TextMutedColor">#93A1B0</Color>
    <Color x:Key="TextFaintColor">#5C6A79</Color>
    <Color x:Key="AccentColor">#22C55E</Color>
    <Color x:Key="AccentHoverColor">#34D96F</Color>
    <Color x:Key="AccentDarkColor">#16A34A</Color>
    <Color x:Key="OnAccentColor">#04140A</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerBgColor">#2A1417</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="WarnBgColor">#2A2113</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="GoodBgColor">#0E241C</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>
    <Color x:Key="InfoBgColor">#111E30</Color>
    <Color x:Key="ScrollThumbColor">#2A3644</Color>
    <Color x:Key="OverlayBgColor">#E60D131A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgSideBrush" Color="{StaticResource BgSideColor}" />
    <SolidColorBrush x:Key="BgTitleBrush" Color="{StaticResource BgTitleColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardAltBrush" Color="{StaticResource CardAltColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="GoodBgBrush" Color="{StaticResource GoodBgColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="OverlayBgBrush" Color="{StaticResource OverlayBgColor}" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#16FFFFFF" />

</ResourceDictionary>
