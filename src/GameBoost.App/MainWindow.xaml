<Window x:Class="GameBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameBoost.App.Controls"
        xmlns:services="clr-namespace:GameBoost.App.Services"
        Title="GameBoost"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/GameBoost.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                      GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <Border Grid.Row="0" Background="{DynamicResource BgTitleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/GameBoost.ico" Width="16" Height="16"
                       VerticalAlignment="Center" Margin="0,0,9,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GameBoost" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="v1.0" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="7,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Border x:Name="ChipCpu" Style="{StaticResource CardFlat}" Padding="9,3"
                            CornerRadius="7" Margin="0,0,6,0"
                            ToolTip="Utilisation du processeur (mise à jour chaque seconde)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,5,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ChipCpuValue" Text="—" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipRam" Style="{StaticResource CardFlat}" Padding="9,3"
                            CornerRadius="7" Margin="0,0,6,0"
                            ToolTip="Mémoire vive utilisée">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="0,0,5,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ChipRamValue" Text="—" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipGpu" Style="{StaticResource CardFlat}" Padding="9,3"
                            CornerRadius="7"
                            ToolTip="Température et charge du processeur graphique">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU" Style="{StaticResource Label}" Margin="0,0,5,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ChipGpuValue" Text="—" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="ThemeButton" Style="{StaticResource WindowButton}"
                            Click="OnThemeClick" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Basculer entre le thème sombre et le thème clair">
                        <TextBlock Text="&#xE706;" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize"
                            FontFamily="{StaticResource IconFont}" FontSize="11"
                            ToolTip="Réduire">
                        <TextBlock Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Click="OnMaximize"
                            FontFamily="{StaticResource IconFont}" FontSize="11"
                            ToolTip="Agrandir ou restaurer">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="OnClose"
                            FontFamily="{StaticResource IconFont}" FontSize="11" ToolTip="Fermer">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corps -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgSideBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,6">
                        <TextBlock Text="ANALYSER · OPTIMISER"
                                   Style="{StaticResource Label}" Margin="18,0,0,8"
                                   Visibility="{Binding LabelsVisible, Source={x:Static services:ShellState.Instance}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,12">
                        <Border Style="{StaticResource CardFlat}" Padding="10,9" CornerRadius="10"
                                ToolTip="Niveau de privilège actuel. Sans administrateur, les températures, certaines priorités et la santé SMART sont indisponibles. La page Paramètres propose une relance élevée.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="ElevationLabel" Text="Utilisateur" Margin="8,0,0,0"
                                           Style="{StaticResource Caption}"
                                           Visibility="{Binding LabelsVisible, Source={x:Static services:ShellState.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="NavPanel" Margin="0,4,0,0">
                        <controls:NavItem x:Name="NavDashboard" Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE80F;" Content="Accueil" IsChecked="True" Checked="OnNavChecked"
                                     Tag="dashboard" ToolTip="Tableau de bord : état du PC en temps réel" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE895;" Content="Analyse" Checked="OnNavChecked"
                                     Tag="analysis" ToolTip="Diagnostic complet du système et corrections" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE9F0;" Content="Mon PC" Checked="OnNavChecked"
                                     Tag="hardware" ToolTip="Fiche détaillée du matériel détecté" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE7F4;" Content="GPU" Checked="OnNavChecked"
                                     Tag="gpu" ToolTip="Carte graphique, pilote et technologies compatibles" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE8B7;" Content="Stockage" Checked="OnNavChecked"
                                     Tag="storage" ToolTip="Disques, espace libre, état et températures" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE7FC;" Content="Jeux" Checked="OnNavChecked"
                                     Tag="games" ToolTip="Jeux détectés (Steam, Epic, Ubisoft, Xbox…)" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE77B;" Content="Profils" Checked="OnNavChecked"
                                     Tag="profiles" ToolTip="Profils graphiques par jeu (Qualité, Équilibré, Performance)" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE7C5;" Content="Applications" Checked="OnNavChecked"
                                     Tag="processes" ToolTip="Processus en cours, ressources utilisées, fermeture ciblée" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE9D9;" Content="Monitoring" Checked="OnNavChecked"
                                     Tag="monitoring" ToolTip="FPS, frametime et overlay pendant le jeu" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE81C;" Content="Historique" Checked="OnNavChecked"
                                     Tag="history" ToolTip="Sessions enregistrées et comparaison A/B" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE8A4;" Content="Rapports" Checked="OnNavChecked"
                                     Tag="reports" ToolTip="Export HTML des analyses et mesures" />
                        <controls:NavItem Style="{StaticResource NavRadio}" GroupName="nav"
                                     Icon="&#xE713;" Content="Paramètres" Checked="OnNavChecked"
                                     Tag="settings" ToolTip="Réglages de GameBoost" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ContentControl x:Name="PageHost" Margin="0" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="2" Background="{DynamicResource BgTitleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding StatusMessage, Source={x:Static services:ShellState.Instance}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                               Text="Données locales · aucun compte requis" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="9,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="Le monitoring est actif" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
